+  div.appendChild(fixes);
+  const details=document.createElement('details'); const summary=document.createElement('summary'); summary.textContent='Release notes'; details.appendChild(summary);
+  const pre=document.createElement('pre'); pre.textContent = r.body || '';
+  details.appendChild(pre);
+  div.appendChild(details);
+  return div;
+}
+function matchesQuery(r, q){ q=q.trim().toLowerCase(); if(!q) return true; const fields=[r.name||'',r.tag||'',r.highlights||'',r.fixes||'',r.body||'']; return fields.join('\n').toLowerCase().includes(q); }
+function apply(){ cardsEl.innerHTML=''; let shown=0; for(const r of data){ if(filter==='stable' && r.prerelease) continue; if(filter==='prerelease' && !r.prerelease) continue; if(!matchesQuery(r, qEl.value)) continue; cardsEl.appendChild(renderCard(r)); shown++; } resultCount.textContent=shown; }
+qEl.addEventListener('input', ()=>apply()); document.querySelectorAll('[data-filter]').forEach(btn=>{ btn.addEventListener('click', ()=>{ filter=btn.getAttribute('data-filter'); apply(); }); });
