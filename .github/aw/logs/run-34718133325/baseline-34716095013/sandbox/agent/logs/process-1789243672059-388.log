      "arguments": "{\"command\":\"python3 - <<'PY'\\nimport json\\np_in='/tmp/gh-aw/agent/github-app-releases.json'\\np_out='/tmp/gh-aw/agent/releases_parsed.json'\\nwith open(p_in,'r',encoding='utf-8') as f:\\n    data=json.load(f)\\n# data expected list\\nout=[]\\nfor item in data:\\n    if not isinstance(item, dict):\\n        continue\\n    if 'id' not in item:\\n        continue\\n    html_url=item.get('html_url')\\n    if isinstance(html_url,str) and html_url.startswith('https://github.com/'):\\n        url=html_url\\n    else:\\n        url='https://github.com/github/app/releases'\\n    out.append({\\n        'id': item.get('id'),\\n        'name': item.get('name') or item.get('tag_name') or '',\\n        'tag_name': item.get('tag_name') or '',\\n        'html_url': url,\\n        'published_at': item.get('published_at'),\\n        'created_at': item.get('created_at'),\\n        'prerelease': bool(item.get('prerelease', False)),\\n        'body': item.get('body') or ''\\n    })\\n# dedupe by id\\nseen=set(); dedup=[]\\nfor it in out:\\n    if it['id'] in seen: continue\\n    seen.add(it['id']); dedup.append(it)\\n# sort by published_at desc, fallback created_at\\nfrom datetime import datetime\\ndef keyfn(it):\\n    k=it.get('published_at') or it.get('created_at') or ''\\n    try:\\n        return datetime.fromisoformat(k.replace('Z','+00:00'))\\n    except Exception:\\n        return datetime.min\\n\\ndedup.sort(key=keyfn, reverse=True)\\nwith open(p_out,'w',encoding='utf-8') as f:\\n    json.dump(dedup,f,ensure_ascii=False,indent=2)\\nprint('WROTE',p_out,'LEN',len(dedup))\\nPY\",\"description\":\"Parse JSON with Python and create smaller parsed JSON file\",\"initial_wait\": 120}",
