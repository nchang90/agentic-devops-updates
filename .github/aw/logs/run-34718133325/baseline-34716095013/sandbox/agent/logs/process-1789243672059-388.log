ils.appendChild(summary);\\n  const pre=document.createElement('pre'); pre.textContent = r.body || '';\\n  details.appendChild(pre);\\n  div.appendChild(details);\\n  return div;\\n}\\nfunction matchesQuery(r, q){ q=q.trim().toLowerCase(); if(!q) return true; const fields=[r.name||'',r.tag||'',r.highlights||'',r.fixes||'',r.body||'']; return fields.join('\\\\n').toLowerCase().includes(q); }\\nfunction apply(){ cardsEl.innerHTML=''; let shown=0; for(const r of data){ if(filter==='stable' && r.prerelease) continue; if(filter==='prerelease' && !r.prerelease) continue; if(!matchesQuery(r, qEl.value)) continue; cardsEl.appendChild(renderCard(r)); shown++; } resultCount.textContent=shown; }\\nqEl.addEventListener('input', ()=>apply()); document.querySelectorAll('[data-filter]').forEach(btn=>{ btn.addEventListener('click', ()=>{ filter=btn.getAttribute('data-filter'); apply(); }); });\\n// initial render\\napply();\\n'''\\n# insert JSON safely\\nhtml_parts.append('<script>')\\nhtml_parts.append(js % js_data)\\nhtml_parts.append('</script>')\\nhtml_parts.append('</main>')\\nhtml_parts.append('</body></html>')\\ncontent='\\\\n'.join(html_parts)\\n# compare with existing\\nif os.path.exists(p_out):\\n    with open(p_out,'r',encoding='utf-8') as f: old=f.read()\\nelse:\\n    old=''\\nif old==content:\\n    # write nothing\\n    print(json.dumps({'changed':False,'count':len(cards),'newest': (cards[0]['name'] if cards else '')}))\\n    sys.exit(0)\\n# write file\\nos.makedirs(os.path.dirname(p_out), exist_ok=True)\\nwith open(p_out,'w',encoding='utf-8',newline='\\\\n') as f:\\n    f.write(content)\\nprint(json.dumps({'changed':True,'count':len(cards),'newest': (cards[0]['name'] if cards else '')}))\\nPY\",\"description\":\"Generate HTML page and report whether changed\",\"initial_wait\": 120}"
