      "arguments": "{\"command\":\"python3 - <<'PY'\\nimport json, os, html, sys\\nfrom datetime import datetime, timezone\\np_in='/tmp/gh-aw/agent/releases_parsed.json'\\np_out='/home/runner/work/Agentic-Workflows/Agentic-Workflows/docs/copilot-app-releases.html'\\nwith open(p_in,'r',encoding='utf-8') as f:\\n    releases=json.load(f)\\ncount=len(releases)\\n# helper extract highlights and fixes\\nimport re\\n\\ndef extract_highlights(body):\\n    if not body:\\n        return ''\\n    # look for headings with 'highlight'\\n    m=re.search(r'(?mi)^#{1,6}\\\\s*(highlights?)\\\\b', body)\\n    if m:\\n        start=m.end()\\n        rest=body[start:]\\n        # take up to next heading\\n        m2=re.search(r'(?m)^#{1,6}\\\\s*\\\\w+', rest)\\n        section=(rest[:m2.start()] if m2 else rest).strip()\\n        return ' '.join(section.split())[:500]\\n    # fallback: first paragraph\\n    parts=[p.strip() for p in re.split(r'\\\\n\\\\s*\\\\n', body) if p.strip()]\\n    return parts[0].strip()[:500] if parts else ''\\n\\n\\ndef extract_fixes(body):\\n    if not body:\\n        return ''\\n    # look for headings with 'fix' or 'bug'\\n    m=re.search(r'(?mi)^#{1,6}\\\\s*(fix(?:es)?|bug(?:s)?)\\\\b', body)\\n    if m:\\n        start=m.end()\\n        rest=body[start:]\\n        m2=re.search(r'(?m)^#{1,6}\\\\s*\\\\w+', rest)\\n        section=(rest[:m2.start()] if m2 else rest).strip()\\n        # collect bullets\\n        bullets=re.findall(r'(?m)^[\\\\-\\\\*\\\\+]\\\\s+(.*)$', section)\\n        if bullets:\\n            return ' '.join([b.strip() for b in bullets])[:500]\\n        return ' '.join(section.split())[:500]\\n    # fallback: find lines mentioning \\\"fix\\\" in bullets\\n    bullets=re.findall(r'(?mi)^[\\\\-\\\\*\\\\+]\\\\s+(.*fix.*)$', body, flags=re.M)\\n    if bullets:\\n        return ' '.join([b.strip() for b in bullets])[:500]\\n    return ''\\n\\n# Build cards data\\ncards=[]\\nfor r in releases:\\n    body=r.get('body','') or ''\\n    highlights=extract_highlights(body)\\n    fixes=extract_fixes(body)\\n    cards.append({\\n        'id': r.get('id'),\\n        'name': r.get('name') or r.get('tag_name') or '',\\n        'tag': r.get('tag_name') or '',\\n        'url': r.get('html_url') or 'https://github.com/github/app/releases',\\n        'published_at': r.get('published_at') or r.get('created_at') or '',\\n        'prerelease': bool(r.get('prerelease', False)),\\n        'highlights': highlights,\\n        'fixes': fixes,\\n        'body': body\\n    })\\n\\n# Generate HTML safely\\nnow=datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\\n\\ntitle='GitHub Copilot App — Releases (official github/app)'\\nhtml_parts=[]\\nhtml_parts.append('<!DOCTYPE html>')\\nhtml_parts.append('<html lang=\\\"en\\\">')\\nhtml_parts.append('<head>')\\nhtml_parts.append(f'<meta charset=\\\"utf-8\\\">')\\nhtml_parts.append(f'<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">')\\nhtml_parts.append(f'<title>{html.escape(title)}</title>')\\n# inline CSS with light/dark\\ncss=r'''\\n:root{--bg:#ffffff;--text:#0f172a;--muted:#475569;--card:#f8fafc;--accent:#0366d6;--badge-bg:#e6eefc}\\n@media (prefers-color-scheme: dark){:root{--bg:#0b1220;--text:#e6eef8;--muted:#9aa7b2;--card:#071021;--accent:#58a6ff;--badge-bg:#06325a}}\\n*{box-sizing:border-box}\\nbody{font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--text);margin:0;padding:1rem}\\n.container{max-width:1100px;margin:0 auto}\\n.header{display:flex;align-items:center;justify-content:space-between;gap:1rem}\\n.controls{display:flex;gap:.5rem;align-items:center}\\n.btn{background:transparent;border:1px solid var(--badge-bg);padding:.4rem .6rem;border-radius:6px;color:var(--text);cursor:pointer}\\n.btn:focus{outline:3px solid var(--accent);outline-offset:2px}\\n.search{flex:1;min-width:180px}\\n.stats{color:var(--muted);font-size:.9rem}\\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin-top:1rem}\\n.card{background:var(--card);padding:1rem;border-radius:8px;border:1px solid rgba(0,0,0,0.04)}\\n.card h3{margin:.1rem 0 .4rem 0}\\n.badge{display:inline-block;background:var(--badge-bg);color:var(--text);padding:2px 6px;border-radius:999px;font-size:.8rem;margin-left:.4rem}\\n.meta{color:var(--muted);font-size:.85rem}\\n.link{color:var(--accent);text-decoration:none}\\n.card pre{white-space:pre-wrap;overflow:auto;background:transparent;padding:0;margin:0}\\n.footer{margin-top:1rem;color:var(--muted)}\\n.visually-hidden{position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden}\\n'''\\nhtml_parts.append(f'<style>{css}</style>')\\n# embed data safely via json.dumps\\njs_data=json.dumps(cards)\\n# ensure script tag not closed by content: using json.dumps is safe\\nhtml_parts.append('</head>')\\nhtml_parts.append('<body>')\\nhtml_parts.append('<main class=\\\"container\\\" role=\\\"main\\\">')\\nhtml_parts.append(f'<header class=\\\"header\\\"><div><h1>{html.escape(title)}</h1><p class=\\\"stats\\\">Source: official github/app releases — generated UTC {now} — total releases: {count}</p></div>')\\nhtml_parts.append('<div class=\\\"controls\\\">')\\nhtml_parts.append('<label for=\\\"q\\\" class=\\\"visually-hidden\\\">Search</label>')\\nhtml_parts.append('<input id=\\\"q\\\" class=\\\"search\\\" type=\\\"search\\\" placeholder=\\\"Search versions, highlights, fixes, notes\\\" aria-label=\\\"Search releases\\\">')\\nhtml_parts.append('<div role=\\\"radiogroup\\\" aria-label=\\\"Filter releases\\\"><button class=\\\"btn\\\" data-filter=\\\"all\\\">All</button><button class=\\\"btn\\\" data-filter=\\\"stable\\\">Stable</button><button class=\\\"btn\\\" data-filter=\\\"prerelease\\\">Prerelease</button></div>')\\nhtml_parts.append('</div></header>')\\nhtml_parts.append('<nav><a href=\\\"https://github.com/github/app/releases\\\" class=\\\"link\\\">Official releases page</a></nav>')\\nhtml_parts.append('<section id=\\\"results-info\\\" class=\\\"stats\\\">Showing <span id=\\\"result-count\\\">0</span> releases</section>')\\nhtml_parts.append('<section class=\\\"grid\\\" id=\\\"cards\\\" aria-live=\\\"polite\\\"></section>')\\nhtml_parts.append('<footer class=\\\"footer\\\">This page is a machine-generated summary of the official github/app release history.</footer>')\\n# JS\\njs=r'''\\nconst data = JSON.parse(%s);\\nconst cardsEl=document.getElementById('cards');\\nconst qEl=document.getElementById('q');\\nconst resultCount=document.getElementById('result-count');\\nlet filter='all';\\nfunction formatDate(s){ if(!s) return ''; try{ const d=new Date(s); return d.toISOString().replace('T',' ').replace('Z',' UTC'); }catch(e){return s}}\\nfunction escapeHtml(s){ return s.replace(/[&<>\\\"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c];}); }\\nfunction renderCard(r){\\n  const div=document.createElement('article'); div.className='card';\\n  const h=document.createElement('h3');\\n  const a=document.createElement('a'); a.href=r.url; a.className='link'; a.textContent=r.name || r.tag || '';\\n  h.appendChild(a);\\n  if(r.prerelease){ const b=document.createElement('span'); b.className='badge'; b.textContent='Prerelease'; h.appendChild(b); }\\n  div.appendChild(h);\\n  const meta=document.createElement('div'); meta.className='meta'; meta.textContent = formatDate(r.published_at);\\n  div.appendChild(meta);\\n  const highlights=document.createElement('p'); highlights.innerHTML = '<strong>Highlights:</strong> '+(r.highlights? escapeHtml(r.highlights): '<em>None listed</em>');\\n  div.appendChild(highlights);\\n  const fixes=document.createElement('p'); fixes.innerHTML = '<strong>Fixes:</strong> '+(r.fixes? escapeHtml(r.fixes): '<em>None listed</em>');\\n  div.appendChild(fixes);\\n  const details=document.createElement('details'); const summary=document.createElement('summary'); summary.textContent='Release notes'; details.appendChild(summary);\\n  const pre=document.createElement('pre'); pre.textContent = r.body || '';\\n  details.appendChild(pre);\\n  div.appendChild(details);\\n  return div;\\n}\\nfunction matchesQuery(r, q){ q=q.trim().toLowerCase(); if(!q) return true; const fields=[r.name||'',r.tag||'',r.highlights||'',r.fixes||'',r.body||'']; return fields.join('\\\\n').toLowerCase().includes(q); }\\nfunction apply(){ cardsEl.innerHTML=''; let shown=0; for(const r of data){ if(filter==='stable' && r.prerelease) continue; if(filter==='prerelease' && !r.prerelease) continue; if(!matchesQuery(r, qEl.value)) continue; cardsEl.appendChild(renderCard(r)); shown++; } resultCount.textContent=shown; }\\nqEl.addEventListener('input', ()=>apply()); document.querySelectorAll('[data-filter]').forEach(btn=>{ btn.addEventListener('click', ()=>{ filter=btn.getAttribute('data-filter'); apply(); }); });\\n// initial render\\napply();\\n'''\\n# insert JSON safely\\nhtml_parts.append('<script>')\\nhtml_parts.append(js % js_data)\\nhtml_parts.append('</script>')\\nhtml_parts.append('</main>')\\nhtml_parts.append('</body></html>')\\ncontent='\\\\n'.join(html_parts)\\n# compare with existing\\nif os.path.exists(p_out):\\n    with open(p_out,'r',encoding='utf-8') as f: old=f.read()\\nelse:\\n    old=''\\nif old==content:\\n    # write nothing\\n    print(json.dumps({'changed':False,'count':len(cards),'newest': (cards[0]['name'] if cards else '')}))\\n    sys.exit(0)\\n# write file\\nos.makedirs(os.path.dirname(p_out), exist_ok=True)\\nwith open(p_out,'w',encoding='utf-8',newline='\\\\n') as f:\\n    f.write(content)\\nprint(json.dumps({'changed':True,'count':len(cards),'newest': (cards[0]['name'] if cards else '')}))\\nPY\",\"description\":\"Generate HTML page and report whether changed\",\"initial_wait\": 120}",
