+function formatDate(s){ if(!s) return ''; try{ const d = new Date(s); return d.toISOString().replace('T',' ').replace('.000Z',' UTC'); }catch(e){return s}}
+
+function renderCard(r){
+  const card = document.createElement('article'); card.className='card';
+  const h = document.createElement('h3'); h.textContent = r.name || r.tag_name || '(untitled)'; card.appendChild(h);
+  const meta = document.createElement('div'); meta.className='meta';
+  const when = document.createElement('div'); when.textContent = formatDate(r.published_at); meta.appendChild(when);
+  const badge = document.createElement('div'); badge.className='badge'; badge.textContent = r.prerelease? 'Prerelease':'Stable'; meta.appendChild(badge);
+  card.appendChild(meta);
+  const highlights = document.createElement('p'); highlights.textContent = r.highlights || (r.body_present? 'See release notes for details.':'None listed'); card.appendChild(highlights);
+  const fixes = document.createElement('p'); fixes.style.color = 'var(--muted)'; fixes.textContent = r.fixes || 'None listed'; card.appendChild(fixes);
+  const a = document.createElement('a'); a.className='view-link'; a.href = r.html_url; a.rel='noopener noreferrer'; a.target='_blank'; a.textContent='View release notes'; card.appendChild(a);
+  return card;
+}
