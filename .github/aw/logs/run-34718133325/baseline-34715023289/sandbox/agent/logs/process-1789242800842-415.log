;margin:2rem auto;padding:1rem}')\\nparts.append('.header{display:flex;align-items:center;justify-content:space-between;gap:1rem}')\\nparts.append('.controls{display:flex;gap:.5rem;align-items:center}')\\nparts.append('input[type=search]{padding:.5rem;border:1px solid #ccc;border-radius:6px;min-width:220px}')\\nparts.append('button{background:var(--accent);color:white;border:0;padding:.5rem .75rem;border-radius:6px;cursor:pointer}')\\nparts.append('button[aria-pressed=\\\"true\\\"]{outline:3px solid rgba(3,102,214,.2)}')\\nparts.append('.controls label{font-size:.9rem;color:var(--muted)}')\\nparts.append('.stats{color:var(--muted);font-size:.9rem}')\\nparts.append('.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin-top:1rem}')\\nparts.append('.card{background:var(--card);padding:1rem;border-radius:8px;box-shadow:0 1px 0 rgba(0,0,0,.04)}')\\nparts.append('.card h3{margin:.1rem 0 .35rem;font-size:1rem}')\\nparts.append('.card .meta{font-size:.85rem;color:var(--muted);display:flex;gap:.5rem;flex-wrap:wrap}')\\nparts.append('.badge{background:var(--badge);padding:.15rem .4rem;border-radius:6px;font-weight:600;font-size:.75rem}')\\nparts.append('.view-link{display:inline-block;margin-top:.5rem;color:var(--accent)}')\\nparts.append('.empty{padding:2rem;text-align:center;color:var(--muted)}')\\nparts.append(':focus{outline:3px solid Highlight;outline-offset:2px}')\\nparts.append('</style>')\\nparts.append('</head>')\\nparts.append('<body>')\\nparts.append('<main class=\\\"container\\\" role=\\\"main\\\">')\\nparts.append('  <header class=\\\"header\\\">')\\nparts.append('    <div>')\\nparts.append('      <h1>GitHub Copilot App — Release history (official)</h1>')\\nparts.append(f'      <p class=\\\"stats\\\">Source: the official <a href=\\\"https://github.com/github/app/releases\\\">github/app releases</a>. Generated: {utc_now} UTC. Total releases: {count}.</p>')\\nparts.append('    </div>')\\nparts.append('    <div class=\\\"controls\\\" aria-hidden=\\\"false\\\">')\\nparts.append('      <label for=\\\"q\\\">Search</label>')\\nparts.append('      <input id=\\\"q\\\" type=\\\"search\\\" placeholder=\\\"Search versions, highlights, fixes, notes\\\" aria-label=\\\"Search releases\\\">')\\nparts.append('      <div role=\\\"radiogroup\\\" aria-label=\\\"Filter releases\\\">')\\nparts.append('        <button id=\\\"all\\\" aria-pressed=\\\"true\\\">All</button>')\\nparts.append('        <button id=\\\"stable\\\" aria-pressed=\\\"false\\\">Stable</button>')\\nparts.append('        <button id=\\\"pre\\\" aria-pressed=\\\"false\\\">Prerelease</button>')\\nparts.append('      </div>')\\nparts.append('    </div>')\\nparts.append('  </header>')\\nparts.append('  <section id=\\\"results\\\" aria-live=\\\"polite\\\">')\\nparts.append(f'    <div id=\\\"count\\\" class=\\\"stats\\\">Showing {count} results</div>')\\nparts.append('    <div id=\\\"cards\\\" class=\\\"grid\\\"></div>')\\nparts.append('  </section>')\\nparts.append('</main>')\\nparts.append('<script>')\\nparts.append('// Serialized release data (escaped to avoid script break)')\\nparts.append('const RELEASES = ' + safe_data + ';')\\nparts.append(\\\"\\\"\\\"\\nfunction formatDate(s){ if(!s) return ''; try{ const d = new Date(s); return d.toISOString().replace('T',' ').replace('.000Z',' UTC'); }catch(e){return s}}\\n\\nfunction renderCard(r){\\n  const card = document.createElement('article'); card.className='card';\\n  const h = document.createElement('h3'); h.textContent = r.name || r.tag_name || '(untitled)'; card.appendChild(h);\\n  const meta = document.createElement('div'); meta.className='meta';\\n  const when = document.createElement('div'); when.textContent = formatDate(r.published_at); meta.appendChild(when);\\n  const badge = document.createElement('div'); badge.className='badge'; badge.textContent = r.prerelease? 'Prerelease':'Stable'; meta.appendChild(badge);\\n  card.appendChild(meta);\\n  const highlights = document.createElement('p'); highlights.textContent = r.highlights || (r.body_present? 'See release notes for details.':'None listed'); card.appendChild(highlights);\\n  const fixes = document.createElement('p'); fixes.style.color = 'var(--muted)'; fixes.textContent = r.fixes || 'None listed'; card.appendChild(fixes);\\n  const a = document.createElement('a'); a.className='view-link'; a.href = r.html_url; a.rel='noopener noreferrer'; a.target='_blank'; a.textContent='View release notes'; card.appendChild(a);\\n  return card;\\n}\\n\\nfunction update(){\\n  const q = document.getElementById('q').value.trim().toLowerCase();\\n  const mode = document.querySelector('button[aria-pressed=\\\"true\\\"]').id;\\n  const cards = document.getElementById('cards'); cards.innerHTML='';\\n  let results = RELEASES.filter(r=>{\\n    if(mode==='stable' && r.prerelease) return false;\\n    if(mode==='pre' && !r.prerelease) return false;\\n    if(!q) return true;\\n    const hay = [r.name,r.tag_name,r.highlights,r.fixes,r.html_url].filter(Boolean).join(' ').toLowerCase();\\n    return hay.indexOf(q)!==-1;\\n  });\\n  document.getElementById('count').textContent = `Showing ${results.length} result${results.length===1?'':'s'}`;\\n  if(results.length===0){ const e = document.createElement('div'); e.className='empty'; e.textContent='No releases match your query.'; cards.appendChild(e); return }\\n  results.forEach(r=>cards.appendChild(renderCard(r)));\\n}\\n\\n['all','stable','pre'].forEach(id=>{\\n  document.getElementById(id).addEventListener('click', e=>{\\n    document.querySelectorAll('#all,#stable,#pre').forEach(b=>b.setAttribute('aria-pressed','false'));\\n    e.currentTarget.setAttribute('aria-pressed','true'); update();\\n  });\\n});\\n\\ndocument.getElementById('q').addEventListener('input', ()=>update());\\n\\n// Initial render\\nupdate();\\n\\\"\\\"\\\")\\nparts.append('</script>')\\nparts.append('</body>')\\nparts.append('</html>')\\n\\nhtml_doc = '\\\\n'.join(parts)\\nwith open(out_path, 'w', encodin