              "arguments": "{\"command\":\"set -euo pipefail\\nREPO_ROOT=/home/runner/work/Agentic-Workflows/Agentic-Workflows\\nJSON=/tmp/gh-aw/agent/github-app-releases.json\\nOUT=${REPO_ROOT}/docs/copilot-app-releases.html\\nBRANCH=release-page-refresh-$(date -u +%Y%m%d-%H%M%SZ)\\nPYTHON=$(which python3 || true)\\nif [ -z \\\"$PYTHON\\\" ]; then\\n  echo \\\"python3 not found\\\" >&2\\n  exit 1\\nfi\\n# Generate HTML\\n$PYTHON - <<'PY'\\nimport json,sys,html,os,re\\nfrom datetime import datetime\\np='/tmp/gh-aw/agent/github-app-releases.json'\\ntry:\\n    with open(p,'r',encoding='utf-8') as f:\\n        data=json.load(f)\\nexcept Exception as e:\\n    print('ERROR reading JSON:',e,file=sys.stderr); sys.exit(1)\\n# normalise list\\nif isinstance(data,dict):\\n    # try common keys\\n    if 'releases' in data and isinstance(data['releases'],list):\\n        items=data['releases']\\n    elif 'items' in data and isinstance(data['items'],list):\\n        items=data['items']\\n    else:\\n        # maybe dict of releases keyed by id\\n        items=list(data.values())\\nelse:\\n    items=data\\n# dedupe by numeric id\\nbyid={}\\nfor r in items:\\n    try:\\n        rid = int(r.get('id') or r.get('node_id') or 0)\\n    except Exception:\\n        rid = 0\\n    if rid==0:\\n        # fallback to tag_name+published_at\\n        rid = (r.get('tag_name') or '') + '|' + (r.get('published_at') or r.get('created_at') or '')\\n    prev = byid.get(rid)\\n    def dt(x):\\n        if not x: return datetime.min\\n        s=str(x)\\n        try:\\n            return datetime.fromisoformat(s.replace('Z','+00:00'))\\n        except Exception:\\n            try:\\n                return datetime.strptime(s, '%Y-%m-%dT%H:%M:%S')\\n            except Exception:\\n                return datetime.min\\n    if prev is None:\\n        byid[rid]=r\\n    else:\\n        # keep latest by published_at then created_at\\n        a = dt(r.get('published_at') or r.get('created_at'))\\n        b = dt(prev.get('published_at') or prev.get('created_at'))\\n        if a >= b:\\n            byid[rid]=r\\nreleases = list(byid.values())\\n# sort by published_at desc, fallback created_at\\ndef keyfunc(r):\\n    s = r.get('published_at') or r.get('created_at') or ''\\n    try:\\n        return datetime.fromisoformat(s.replace('Z','+00:00'))\\n    except Exception:\\n        return datetime.min\\nreleases.sort(key=keyfunc, reverse=True)\\n# helper extract\\nimport urllib.parse\\nHOST_ALLOW='github.com'\\ncards = []\\nfor r in releases:\\n    name = r.get('name') or r.get('tag_name') or ''\\n    tag = r.get('tag_name') or ''\\n    url = r.get('html_url') or ''\\n    if url and url.startswith('https://'):\\n        try:\\n            host = urllib.parse.urlparse(url).hostname or ''\\n        except Exception:\\n            host=''\\n        if host.lower() != HOST_ALLOW:\\n            url = 'https://github.com/github/app/releases'\\n    else:\\n        url = 'https://github.com/github/app/releases'\\n    published = r.get('published_at') or r.get('created_at') or ''\\n    # format UTC\\n    pubstr = ''\\n    try:\\n        dt = datetime.fromisoformat(published.replace('Z','+00:00'))\\n        pubstr = dt.strftime('%Y-%m-%dT%H:%M:%SZ')\\n    except Exception:\\n        pubstr = published\\n    prerelease = bool(r.get('prerelease'))\\n    body = (r.get('body') or '').strip()\\n    # highlights: first non-empty paragraph up to 300 chars\\n    highlights = 'None listed'\\n    for para in re.split(r'\\\\n\\\\s*\\\\n', body):\\n        p = para.strip()\\n        if p:\\n            highlights = p.replace('\\\\n',' ')[:600]\\n            break\\n    # fixes: look for lines mentioning fix\\n    fixes_lines = []\\n    for line in body.splitlines():\\n        if re.search(r'\\\\bfix(es|ed)?\\\\b', line, re.I):\\n            tl = line.strip()\\n            if tl and tl not in fixes_lines:\\n                fixes_lines.append(tl)\\n        if len(fixes_lines)>=5:\\n            break\\n    fixes = 'None listed' if not fixes_lines else ' '.join(fixes_lines[:3])\\n    cards.append({\\n        'name': name,'tag': tag,'url': url,'published': pubstr,'prerelease': prerelease,'highlights': highlights,'fixes': fixes,'body': body\\n    })\\n# build HTML\\nout='''<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<title>GitHub Copilot App — Releases</title>\\n<style>\\n:root{--bg:#fff;--text:#111;--muted:#555;--card:#f8f8f8;--accent:#0366d6}\\n@media(prefers-color-scheme:dark){:root{--bg:#0b1117;--text:#e6edf3;--muted:#9aa4ad;--card:#071226;--accent:#58a6ff}}\\nhtml,body{height:100%;margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif}\\n.container{max-width:960px;margin:32px auto;padding:16px}\\n.header{display:flex;align-items:center;justify-content:space-between;gap:16px}\\n.controls{display:flex;gap:8px;align-items:center}\\ninput[type=search]{padding:8px;border-radius:6px;border:1px solid #ccc;background:transparent;color:var(--text)}\\n.btn{padding:6px 10px;border-radius:6px;border:1px solid #ccc;background:transparent;color:var(--text);cursor:pointer}\\n.radio{margin-left:8px}\\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin-top:16px}\\n.card{background:var(--card);padding:12px;border-radius:8px;border:1px solid rgba(0,0,0,0.06)}\\n.badge{display:inline-block;padding:3px 8px;border-radius:999px;font-size:12px;background:rgba(3,102,214,0.12);color:var(--accent)}\\n.prerelease{background:rgba(255,165,0,0.12);color:orange}\\n.meta{color:var(--muted);font-size:13px;margin-bottom:8px}\\n.link{color:var(--accent);text-decoration:none}\\n.count{font-size:14px;color:var(--muted)}\\n.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\\n:focus{outline:3px solid #8ab4ff;outline-offset:2px}\\n</style>\\n</head>\\n<body>\\n<main class=\\\"container\\\" role=\\\"main\\\">\\n<header class=\\\"header\\\">\\n<div>\\n<h1>GitHub Copilot App — Releases</h1>\\n<p class=\\\"count\\\" id=\\\"meta-desc\\\">Source: official github/app release history. Generated at UTC: {gen_ts} — Total releases: {count}</p>\\n<p><a href=\\\"https://github.com/github/app/releases\\\" class=\\\"link\\\">Official releases page</a></p>\\n</div>\\n<div class=\\\"controls\\\" role=\\\"region\\\" aria-label=\\\"search and filters\\\">\\n<label for=\\\"q\\\" class=\\\"visually-hidden\\\">Search releases</label>\\n<input id=\\\"q\\\" type=\\\"search\\\" placeholder=\\\"Search versions, highlights, fixes\\\" aria-label=\\\"Search releases\\\">\\n<select id=\\\"filter\\\" class=\\\"btn\\\" aria-label=\\\"Filter release type\\\">\\n<option value=\\\"all\\\">All</option>\\n<option value=\\\"stable\\\">Stable</option>\\n<option value=\\\"prerelease\\\">Prerelease</option>\\n</select>\\n<span id=\\\"result-count\\\" class=\\\"count\\\">{count} results</span>\\n</div>\\n</header>\\n<section id=\\\"cards\\\" class=\\\"grid\\\" aria-live=\\\"polite\\\">\\n</section>\\n</main>\\n<script>\\n// serialized data\\nconst RELEASES = {data};\\nfunction escHtml(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}\\nconst container = document.getElementById('cards');\\nconst q = document.getElementById('q');\\nconst filter = document.getElementById('filter');\\nconst resultCount = document.getElementById('result-count');\\nfunction render(list){\\n  container.innerHTML='';\\n  for(const r of list){\\n    const card = document.createElement('article'); card.className='card';\\n    const title = document.createElement('h3');\\n    const name = r.name || r.tag || '(untitled)';\\n    const a = document.createElement('a'); a.href = r.url; a.className='link'; a.textContent = name;\\n    a.target='_blank'; a.rel='noopener noreferrer';\\n    title.appendChild(a);\\n    const meta = document.createElement('div'); meta.className='meta';\\n    const badge = document.createElement('span'); badge.className='badge' + (r.prerelease? ' prerelease':''); badge.textContent = r.prerelease? 'Prerelease':'Stable';\\n    meta.appendChild(badge);\\n    const pub = document.createElement('span'); pub.style.marginLeft='8px'; pub.textContent = ' ' + (r.published || '');\\n    meta.appendChild(pub);\\n    const highlights = document.createElement('p'); highlights.textContent = r.highlights || 'None listed';\\n    const fixes = document.createElement('p'); fixes.textContent = 'Fixes: ' + (r.fixes || 'None listed'); fixes.style.fontSize='13px'; fixes.style.color='var(--muted)';\\n    const btn = document.createElement('div');\\n    const link = document.createElement('a'); link.href=r.url; link.textContent='View release notes'; link.className='link'; link.target='_blank'; link.rel='noopener noreferrer';\\n    btn.appendChild(link);\\n    card.appendChild(title); card.appendChild(meta); card.appendChild(highlights); card.appendChild(fixes); card.appendChild(btn);\\n    container.appendChild(card);\\n  }\\n  resultCount.textContent = list.length + ' results';\\n}\\nfunction matches(r,term){\\n  term = term.toLowerCase();\\n  return (r.name||'').toLowerCase().includes(term) || (r.tag||'').toLowerCase().includes(term) || (r.highlights||'').toLowerCase().includes(term) || (r.fixes||'').toLowerCase().includes(term) || (r.body||'').toLowerCase().includes(term);\\n}\\nfunction filterAndRender(){\\n  const term = q.value.trim();\\n  const f = filter.value;\\n  let list = RELEASES.slice();\\n  if(f==='stable') list = list.filter(r=>!r.prerelease);\\n  else if(f==='prerelease') list = list.filter(r=>r.prerelease);\\n  if(term) list = list.filter(r=>matches(r,term));\\n  render(list);\\n}\\nq.addEventListener('input', filterAndRender);\\nfilter.addEventListener('change', filterAndRender);\\n// initial render\\nfilterAndRender();\\n</script>\\n</body>\\n</html>'''\\n# prepare data and write\\nfrom datetime import datetime\\ngen_ts = datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')\\ncount = len(releases)\\n# safe-serialize JSON for JS\\nimport json\\njsdata = json.dumps(cards).replace('</','<\\\\\\\\/')\\nout_f = out = os.path.join(os.environ.get('REPO_ROOT','.'),'docs','copilot-app-releases.html')\\ntry:\\n    html_text = out.format(gen_ts=gen_ts,count=count,data=jsdata)\\nexcept Exception as e:\\n    print('ERROR formatting HTML',e,file=sys.stderr); sys.exit(1)\\n# ensure docs dir exists\\nos.makedirs(os.path.dirname(out_f), exist_ok=True)\\nwith open(out_f,'w',encoding='utf-8') as f:\\n    f.write(html_text)\\nprint('WROTE',out_f)\\nprint('COUNT',count)\\nprint('NEWEST',releases[0].get('tag_name') or releases[0].get('name') if releases else '')\\nPY\\n# Git commit steps\\ncd $REPO_ROOT\\n# ensure git user\\ngit config user.email \\\"action@localhost\\\" || true\\ngit config user.name \\\"Copilot CLI\\\" || true\\n# create branch\\ngit checkout -b \\\"$BRANCH\\\"\\n# add file and commit\\ngit add docs/copilot-app-releases.html\\ngit commit -m \\\"refresh release page\\n\\nRelease page refreshed: see docs/copilot-app-releases.html\\n\\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>\\\"\\n# print branch name\\ngit branch --show-current\\n\", \"description\":\"Generate HTML from JSON, commit to new branch, and output branch name\",\"initial_wait\":120}"
