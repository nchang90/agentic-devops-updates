      "name": "bash",
      "arguments": "{\"command\":\"set -euo pipefail\\nexport TMPDIR=/tmp/gh-aw/agent\\nmkdir -p \\\"$TMPDIR\\\"\\nJSON_PATH=\\\"$TMPDIR/github-app-releases.json\\\"\\nINPUT_JSON=\\\"$JSON_PATH\\\"\\nOUT_HTML=\\\"$TMPDIR/copilot-app-releases.html\\\"\\nREPO_HTML=\\\"/home/runner/work/Agentic-Workflows/Agentic-Workflows/docs/copilot-app-releases.html\\\"\\n\\n# Use Python to parse JSON and generate HTML into OUT_HTML. Also print metadata to a temp info file.\\npython3 - <<'PY'\\nimport json, html, sys, os\\nfrom datetime import datetime\\n\\nin_path = os.environ['INPUT_JSON']\\nout_path = os.environ['OUT_HTML']\\n\\nwith open(in_path, 'r', encoding='utf-8') as f:\\n    data = json.load(f)\\n\\n# Deduplicate by numeric id (if 'id' present), otherwise use tuple of allowed fields\\nseen = {}\\nfor r in data:\\n    rid = r.get('id')\\n    key = rid if isinstance(rid, int) else json.dumps(r, sort_keys=True)\\n    if key in seen:\\n        continue\\n    seen[key] = r\\n\\nreleases = list(seen.values())\\n\\n# parse date helper\\nfrom dateutil import parser\\n\\ndef parse_date(s):\\n    if not s:\\n        return None\\n    try:\\n        return parser.isoparse(s)\\n    except Exception:\\n        return None\\n\\n# sort by published_at desc, fallback to created_at\\nreleases.sort(key=lambda r: (parse_date(r.get('published_at')) or parse_date(r.get('created_at')) or datetime.min), reverse=True)\\n\\n# allowed fields only\\nout_list = []\\nfor r in releases:\\n    item = {k: r.get(k) for k in ('name','tag_name','html_url','published_at','created_at','prerelease','body')}\\n    out_list.append(item)\\n\\n# Helper to derive highlights and fixes summary conservatively\\nimport re\\n\\ndef first_paragraph(text):\\n    if not text:\\n        return ''\\n    parts = re.split(r\\\"\\\\n\\\\s*\\\\n+\\\", text.strip())\\n    if parts:\\n        p = parts[0].strip()\\n        return ' '.join(p.split())[:300]\\n    return ''\\n\\ndef fixes_summary(text):\\n    if not text:\\n        return None\\n    lines = [ln.strip('-* \\\\t') for ln in text.splitlines()]\\n    hits = [ln for ln in lines if re.search(r'\\\\bfix(es|ed)?\\\\b', ln, re.I) or re.search(r'bug', ln, re.I)]\\n    if hits:\\n        # keep up to 3 concise lines\\n        res = []\\n        for h in hits[:3]:\\n            s = ' '.join(h.split())\\n            res.append(s[:200])\\n        return ' • '.join(res)\\n    return None\\n\\n# Build a serializable structure for client-side\\nserialized = []\\nfor r in out_list:\\n    name = r.get('name') or ''\\n    tag = r.get('tag_name') or ''\\n    url = r.get('html_url') or ''\\n    # enforce https github.com host per spec\\n    if url and url.startswith('https://') and 'github.com' in url:\\n        link = url\\n    else:\\n        link = 'https://github.com/github/app/releases'\\n    published = r.get('published_at') or r.get('created_at') or ''\\n    prerelease = bool(r.get('prerelease'))\\n    body = r.get('body') or ''\\n    highlights = first_paragraph(body)\\n    fixes = fixes_summary(body)\\n    serialized.append({\\n        'name': name,\\n        'tag_name': tag,\\n        'html_url': link,\\n        'published_at': published,\\n        'prerelease': prerelease,\\n        'highlights': highlights,\\n        'fixes': fixes,\\n        'body_present': bool(body.strip())\\n    })\\n\\n# meta\\ncount = len(serialized)\\nnewest = serialized[0]['tag_name'] or serialized[0]['name'] if count>0 else ''\\n\\n# Build HTML\\n# Escape all displayed values when inserting into HTML text; JS will get the JSON separately (safe-serialized)\\n\\ndef escape_js(s):\\n    # Use json dumps for safe JS string, then replace </ to <\\\\/ to avoid script break\\n    import json\\n    j = json.dumps(s)\\n    return j.replace('</', '<\\\\\\\\/')\\n\\nimport json\\nsafe_data = json.dumps(serialized, ensure_ascii=False).replace('</', '<\\\\\\\\/')\\n\\nutc_now = datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')\\n\\nhtml_doc = f'''<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<title>GitHub Copilot App — Release history (official)</title>\\n<style>\\n:root{{--bg:#fff;--fg:#111;--muted:#555;--card:#f7f7f8;--accent:#0366d6;--badge:#e1ecf4}}\\n@media(prefers-color-scheme:dark){{:root{{--bg:#0b0b0d;--fg:#e6eef8;--muted:#9aa8bd;--card:#0f1720;--accent:#58a6ff;--badge:#073642}}}}\\nhtml,body{{height:100%}}body{{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial; background:var(--bg);color:var(--fg);line-height:1.4}}\\n.container{{max-width:980px;margin:2rem auto;padding:1rem}}\\n.header{{display:flex;align-items:center;justify-content:space-between;gap:1rem}}\\n.controls{display:flex;gap:.5rem;align-items:center}\\ninput[type=search]{padding:.5rem;border:1px solid #ccc;border-radius:6px;min-width:220px}\\nbutton{background:var(--accent);color:white;border:0;padding:.5rem .75rem;border-radius:6px;cursor:pointer}\\nbutton[aria-pressed='true']{outline:3px solid rgba(3,102,214,.2)}\\n.controls label{font-size:.9rem;color:var(--muted)}\\n.stats{color:var(--muted);font-size:.9rem}\\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin-top:1rem}\\n.card{background:var(--card);padding:1rem;border-radius:8px;box-shadow:0 1px 0 rgba(0,0,0,.04)}\\n.card h3{margin:.1rem 0 .35rem;font-size:1rem}\\n.card .meta{font-size:.85rem;color:var(--muted);display:flex;gap:.5rem;flex-wrap:wrap}\\n.badge{background:var(--badge);padding:.15rem .4rem;border-radius:6px;font-weight:600;font-size:.75rem}\\n.view-link{display:inline-block;margin-top:.5rem;color:var(--accent)}\\n.empty{padding:2rem;text-align:center;color:var(--muted)}\\n:focus{outline:3px solid Highlight;outline-offset:2px}\\n</style>\\n</head>\\n<body>\\n<main class=\\\"container\\\" role=\\\"main\\\">\\n  <header class=\\\"header\\\">\\n    <div>\\n      <h1>GitHub Copilot App — Release history (officia