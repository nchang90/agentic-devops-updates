_path, 'w', encoding='utf-8') as f:\\n    f.write(html_doc)\\n\\ninfo_path = os.path.join('/tmp/gh-aw/agent','gen_info.json')\\nwith open(info_path,'w',encoding='utf-8') as f:\\n    json.dump({'count': count, 'newest': newest}, f, ensure_ascii=False)\\nprint('WROTE', out_path)\\nprint(info_path)\\nPY\\n\\n# Read metadata\\nINFO_JSON=\\\"/tmp/gh-aw/agent/gen_info.json\\\"\\nCOUNT=$(jq -r '.count' \\\"$INFO_JSON\\\")\\nNEWEST=$(jq -r '.newest' \\\"$INFO_JSON\\\")\\n\\necho \\\"Generated count=$COUNT newest=$NEWEST\\\"\\n\\n# Compare with repo file if exists\\nif [ -f \\\"$REPO_HTML\\\" ]; then\\n  if cmp -s \\\"$OUT_HTML\\\" \\\"$REPO_HTML\\\"; then\\n    echo \\\"unchanged\\\"\\n    jq -n --arg msg \\\"docs/copilot-app-releases.html unchanged (no update necessary). Generated ${COUNT} releases; newest ${NEWEST}.\\\" '{reason: $msg}' | safeoutputs noop .\\n    exit 0\\n  fi\\nfi\\n\\nBRANCH=\\\"refresh-release-page-$(date -u +%Y%m%dT%H%M%SZ)\\\"\\n\\ngit checkout -b \\\"$BRANCH\\\"\\nmkdir -p \\\"$(dirname \\\"$REPO_HTML\\\")\\\"\\ncp \\\"$OUT_HTML\\\" \\\"$REPO_HTML\\\"\\ngit add \\\"$REPO_HTML\\\"\\nCOMMIT_MSG=\\\"refresh release page\\\\n\\\\nRelease count: ${COUNT}\\\\nNewest version: ${NEWEST}\\\\n\\\\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>\\\"\\n\\necho \\\"$COMMIT_MSG\\\" | git commit -F -\\n\\nPR_BODY=\\\"Release count: ${COUNT}\\\\nNewest version: ${NEWEST}\\\"\\njq -n --arg title \\\"refresh release page\\\" --arg body \\\"$PR_BODY\\\" --arg branch \\\"$BRANCH\\\" '{title:$title, body:$body, branch:$branch}' | safeoutputs create_pull_request .\\n\", \"description\":\"Generate HTML from JSON, compare, and create PR or noop (fixed env path)\",\"initial_wait\":120}",
