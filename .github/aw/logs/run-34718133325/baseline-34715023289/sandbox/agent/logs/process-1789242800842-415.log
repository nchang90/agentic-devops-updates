th:980px;margin:2rem auto;padding:1rem}')\\nparts.append('.header{display:flex;align-items:center;justify-content:space-between;gap:1rem}')\\nparts.append('.controls{display:flex;gap:.5rem;align-items:center}')\\nparts.append('input[type=search]{padding:.5rem;border:1px solid #ccc;border-radius:6px;min-width:220px}')\\nparts.append('button{background:var(--accent);color:white;border:0;padding:.5rem .75rem;border-radius:6px;cursor:pointer}')\\nparts.append('button[aria-pressed=\\\"true\\\"]{outline:3px solid rgba(3,102,214,.2)}')\\nparts.append('.controls label{font-size:.9rem;color:var(--muted)}')\\nparts.append('.stats{color:var(--muted);font-size:.9rem}')\\nparts.append('.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin-top:1rem}')\\nparts.append('.card{background:var(--card);padding:1rem;border-radius:8px;box-shadow:0 1px 0 rgba(0,0,0,.04)}')\\nparts.append('.card h3{margin:.1rem 0 .35rem;font-size:1rem}')\\nparts.append('.card .meta{font-size:.85rem;color:var(--muted);display:flex;gap:.5rem;flex-wrap:wrap}')\\nparts.append('.badge{background:var(--badge);padding:.15rem .4rem;border-radius:6px;font-weight:600;font-size:.75rem}')\\nparts.append('.view-link{display:inline-block;margin-top:.5rem;color:var(--accent)}')\\nparts.append('.empty{padding:2rem;text-align:center;color:var(--muted)}')\\nparts.append(':focus{outline:3px solid Highlight;outline-offset:2px}')\\nparts.append('</style>')\\nparts.append('</head>')\\nparts.append('<body>')\\nparts.append('<main class=\\\"container\\\" role=\\\"main\\\">')\\nparts.append('  <header class=\\\"header\\\">')\\nparts.append('    <div>')\\nparts.append('      <h1>GitHub Copilot App — Release history (official)</h1>')\\nparts.append(f'      <p class=\\\"stats\\\">Source: the official <a href=\\\"https://github.com/github/app/releases\\\">github/app releases</a>. Generated: {utc_now} UTC. Total releases: {count}.</p>')\\nparts.append('    </div>')\\nparts.append('    <div class=\\\