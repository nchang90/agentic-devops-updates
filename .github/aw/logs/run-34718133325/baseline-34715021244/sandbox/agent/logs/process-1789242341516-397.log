ne:3px solid #ffd33d;outline-offset:2px}\\n</style>\\n</head>\\n<body>\\n<main class=\\\"container\\\" role=\\\"main\\\">\\n  <header class=\\\"header\\\">\\n    <div>\\n      <div class=\\\"title\\\">GitHub Copilot App — Official release history</div>\\n      <div class=\\\"count\\\">Source: github/app Releases API • Generated UTC: {gen_ts} • Total releases: {count}</div>\\n    </div>\\n    <div class=\\\"controls\\\">\\n      <label for=\\\"search\\\" class=\\\"visually-hidden\\\">Search releases</label>\\n      <input id=\\\"search\\\" class=\\\"search\\\" placeholder=\\\"Search versions, highlights, fixes, notes\\\" aria-label=\\\"Search releases\\\">\\n      <div class=\\\"filters\\\" role=\\\"group\\\" aria-label=\\\"Filter releases\\\">\\n        <button data-filter=\\\"all\\\">All</button>\\n        <button data-filter=\\\"stable\\\">Stable</button>\\n        <button data-filter=\\\"prerelease\\\">Prerelease</button>\\n      </div>\\n    </div>\\n  </header>\\n  <p style=\\\"margin-top:12px\\\">Official source: <a href=\\\"https://github.com/github/app/releases\\\">github.com/github/app/releases</a></p>\\n  <section aria-live=\\\"polite\\\" class=\\\"grid\\\" id=\\\"cards\\\" ></section>\\n</main>\\n<script id=\\\"releases-data\\\" type=\\\"application/json\\\">{json_text}</script>\\n<script>\\n(function(){\\n  const releases = JSON.parse(document.getElementById('releases-data').textContent);\\n  const container = document.getElementById('cards');\\n  function esc(t){ const d=document.createElement('div'); d.textContent=t; return d.innerHTML }\\n  function formatDate(s){ if(!s) return ''; try{ const d=new Date(s); return d.toISOString().replace('T',' ').replace('Z',' UTC') }catch(e){ return s }}\\n  function makeCard(r){\\n    const el = document.createElement('article'); el.className='card'; el.tabIndex=0;\\n    const h = document.createElement('h3'); h.innerHTML = esc(r.name || r.tag) + (r.tag? (' <span class=\\\"badge\\\">'+esc(r.tag)+'</span>') : '');\\n    el.appendChild(h);\\n    const m = document.createElement('div'); m.className='meta'; m.textContent = (r.prerelease? 'Prerelease • ' : '') + formatDate(r.published || '');\\n    el.appendChild(m);\\n    const hlTitle = document.createElement('div'); hlTitle.className='section-title'; hlTitle.textContent = 'Highlights'; el.appendChild(hlTitle);\\n    const hl = document.createElement('p'); hl.textContent = r.highlights || 'None listed'; el.appendChild(hl);\\n    const fixesTitle = document.createElement('div'); fixesTitle.className='section-title'; fixesTitle.textContent='Fixes'; el.appendChild(fixesTitle);\\n    const fixes = document.createElement('p'); fixes.textContent = r.fixes || 'None listed'; el.appendChild(fixes);\\n    const a = document.createElement('a'); a.className='link'; a.href = r.link; a.textContent = 'View release notes'; a.target='_blank' ; a.rel='noopener noreferrer'; el.appendChild(a);\\n    return el;\\n  }\\n  function render(list){ container.innerHTML=''; list.forEach(r=>container.appendChild(makeCard(r))); document.querySelector('.count').textContent = 'Source: github/app Releases API • Generated UTC: '+(new Date().toISOString().replace(/\\\\.\\\\d+Z$/,'Z'))+' • Results: '+list.length; }\\n  function filterAndSearch(){ const q = (document.getElementById('search').value||'').toLowerCase(); const f = document.querySelector('[data-active]')?.dataset.active || 'all'; let out = releases.filter(r=>{\\n    if(f==='stable' && r.prerelease) return false;\\n    if(f==='prerelease' && !r.prerelease) return false;\\n    if(!q) return true;\\n    const hay = ((r.name||'')+' '+(r.tag||'')+' '+(r.highlights||'')+' '+(r.fixes||'')+' '+(r.link||'')).toLowerCase();\\n    return hay.indexOf(q) !== -1;\\n  });\\n  render(out);\\n}\\n  // initialize\\n  document.querySelectorAll('.filters button').forEach(b=>{ b.addEventListener('click', e=>{\\n    document.querySelectorAll('.filters button').forEach(x=>x.removeAttribute('data-active'));\\n    b.setAttribute('data-active','1'); b.dataset.active = b.dataset.filter || b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = (b.getAttribute('data-filter')||b.textContent.toLowerCase()); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); // defensive\\n    filterAndSearch();\\n  });\\n  // set All active by default\\n  const allBtn = document.querySelector('.filters button[data-filter=\\\"all\\\"]') || document.querySelector('.filters button'); if(allBtn){ allBtn.setAttribute('data-active','1'); }\\n  document.getElementById('search').addEventListener('input', filterAndSearch);\\n  // initial render\\n  render(releases);\\n})();\\n</script>\\n</body>\\n</html>\\n\\\"\\\"\\\"\\n\\n# ensure docs dir exists\\nos.makedirs(os.path.dirname(out), exist_ok=True)\\nwith open(out,'w',encoding='utf-8') as f:\\n    f.write(html_text)\\nprint(f'WROTE:{out}\\\\nCOUNT:{count}\\\\nNEWEST:{newest}')\\nPY\\n# Git prepare branch and commit\\nBRANCH=\\\"refresh-release-$(date -u +%Y%m%dT%H%M%SZ)\\\"\\n# configure user if needed\\ngit config user.email \\\"copilot@users.noreply.github.com\\\" || true\\ngit config user.name \\\"Copilot\\\" || true\\n# create branch, add and commit only the file\\ngit checkout -b \\\"$BRANCH\\\"\\ngit add docs/copilot-app-releases.html\\ngit commit -m \\\"refresh release page\\\" -m \\\"Release count: $(python3 -c 'import json;print(len(json.load(open(\\\"/tmp/gh-aw/agent/github-app-releases.json\\\"))) )')\\\\nNewest: $(head -n 1 /tmp/gh-aw/agent/github-app-releases.json | sed -n '1,1p')\\\\n\\\\nCo-authored-by: