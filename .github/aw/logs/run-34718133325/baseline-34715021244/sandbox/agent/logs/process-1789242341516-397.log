      "arguments": "{\"command\":\"set -euo pipefail\\ncd /home/runner/work/Agentic-Workflows/Agentic-Workflows\\nPYTHONPATH=.\\npython3 - <<'PY'\\nimport json, re, html, sys, os, urllib.parse\\nfrom datetime import datetime\\n\\nsrc = '/tmp/gh-aw/agent/github-app-releases.json'\\nout = 'docs/copilot-app-releases.html'\\nwith open(src,'r',encoding='utf-8') as f:\\n    data = json.load(f)\\n# Deduplicate by numeric id\\nseen = {}\\nfor r in data:\\n    rid = r.get('id')\\n    if rid is None:\\n        continue\\n    if rid in seen:\\n        continue\\n    seen[rid] = r\\nreleases = list(seen.values())\\n# parse date helper\\ndef parse_dt(s):\\n    if not s: return None\\n    try:\\n        # ISO format, with Z\\n        if s.endswith('Z'):\\n            s = s[:-1] + '+00:00'\\n        return datetime.fromisoformat(s)\\n    except Exception:\\n        return None\\n\\n# sort by published_at desc, fallback created_at\\nreleases.sort(key=lambda r: (parse_dt(r.get('published_at')) or parse_dt(r.get('created_at')) or datetime.min), reverse=True)\\n\\n# helpers to extract sections\\nheading_re = re.compile(r'(?m)^(#{1,4})\\\\s*(.+)\\\\s*$')\\n\\ndef extract_section(body, cand_names):\\n    if not body:\\n        return None\\n    # normalize CRLF\\n    body = body.replace('\\\\r\\\\n','\\\\n')\\n    lines = body.split('\\\\n')\\n    # find heading indices\\n    indices = []\\n    for i,l in enumerate(lines):\\n        m = heading_re.match(l)\\n        if m:\\n            title = m.group(2).strip()\\n            indices.append((i,title))\\n    # find candidate section\\n    for idx,title in indices:\\n        for cand in cand_names:\\n            if title.lower().startswith(cand.lower()):\\n                # collect until next heading or end\\n                j = idx+1\\n                out_lines = []\\n                while j < len(lines) and not heading_re.match(lines[j]):\\n                    out_lines.append(lines[j])\\n                    j += 1\\n                text = '\\\\n'.join(out_lines).strip()\\n                if text:\\n                    return text\\n    return None\\n\\n# process each release into safe fields\\nprocessed = []\\nfor r in releases:\\n    name = r.get('name') or r.get('tag_name') or ''\\n    tag = r.get('tag_name') or ''\\n    raw_url = r.get('html_url') or ''\\n    # validate link\\n    link = 'https://github.com/github/app/releases'\\n    try:\\n        p = urllib.parse.urlparse(raw_url)\\n        if p.scheme == 'https' and p.netloc == 'github.com':\\n            link = raw_url\\n    except Exception:\\n        pass\\n    published = r.get('published_at') or r.get('created_at') or ''\\n    prerelease = bool(r.get('prerelease'))\\n    body = r.get('body') or ''\\n    highlights = extract_section(body, ['Highlights', \\\"What's new\\\", 'What’s new', 'Highlights:'])\\n    if not highlights:\\n        # fallback: first paragraph up to first blank line\\n        para = body.strip().split('\\\\n\\\\n',1)[0].strip()\\n        highlights = para if para else None\\n    fixes = extract_section(body, ['Fixed','Fixes','Fixed:','### Fixed','### Fixes'])\\n    # if fixes present, extract bullet list items\\n    fixes_summary = None\\n    if fixes:\\n        # collect up to first 6 bullet lines\\n        items = [line.strip('-* ') for line in fixes.splitlines() if line.strip().startswith(('-', '*'))]\\n        if not items:\\n            # maybe paragraph\\n            fixes_summary = fixes.strip()\\n        else:\\n            fixes_summary = '\\\\n'.join(items[:6])\\n    processed.append({\\n        'id': r.get('id'),\\n        'name': name,\\n        'tag': tag,\\n        'link': link,\\n        'published': published,\\n        'prerelease': prerelease,\\n        'highlights': highlights or '',\\n        'fixes': fixes_summary or ''\\n    })\\n\\n# generation timestamp and count\\ngen_ts = datetime.utcnow().replace(microsecond=0).isoformat() + 'Z'\\ncount = len(processed)\\nnewest = processed[0]['tag'] if processed else ''\\n\\n# safe JSON for embedding: escape </script> and U+2028/2029\\njson_text = json.dumps(processed, ensure_ascii=False)\\njson_text = json_text.replace('</script>','<\\\\\\\\/script>')\\njson_text = json_text.replace('\\\\u2028','\\\\\\\\u2028').replace('\\\\u2029','\\\\\\\\u2029')\\n\\nhtml_text = f\\\"\\\"\\\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<title>GitHub Copilot App — Release history (official)</title>\\n<style>\\n:root{--bg:#fff;--fg:#0b0b0b;--muted:#6b7280;--card:#f9fafb;--accent:#0366d6}\\n@media (prefers-color-scheme: dark) {{:root{{--bg:#0b1220;--fg:#e6eef8;--muted:#9aa9bf;--card:#051024;--accent:#58a6ff}}}}\\nhtml,body{{height:100%;margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}}\\n.container{{max-width:980px;margin:24px auto;padding:16px}}\\n.header{{display:flex;align-items:center;justify-content:space-between;gap:12px}}\\n.title{{font-size:1.25rem;font-weight:600}}\\n.controls{{display:flex;gap:8px;align-items:center}}\\n.search{{padding:8px;border:1px solid #ddd;border-radius:6px}}\\n.filters button{{padding:6px 10px;border-radius:6px;border:1px solid #ddd;background:transparent;cursor:pointer}}\\n.count{{color:var(--muted);font-size:0.95rem}}\\n.grid{{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-top:16px}}\\n.card{{background:var(--card);padding:12px;border-radius:8px;border:1px solid rgba(0,0,0,0.05)}}\\n.card h3{margin:0 0 6px 0;font-size:1rem}\\n.badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:0.75rem;border:1px solid rgba(0,0,0,0.08);margin-left:8px}\\n.meta{font-size:0.9rem;color:var(--muted);margin-bottom:8px}\\n.section-title{font-weight:600;margin-top:8px}\\n.card p, .card ul{margin:6px 0}\\n.link{color:var(--accent);text-decoration:none}\\n:focus{outline:3px solid #ffd33d;outline-offset:2px}\\n</style>\\n</head>\\n<body>\\n<main class=\\\"container\\\" role=\\\"main\\\">\\n  <header class=\\\"header\\\">\\n    <div>\\n      <div class=\\\"title\\\">GitHub Copilot App — Official release history</div>\\n      <div class=\\\"count\\\">Source: github/app Releases API • Generated UTC: {gen_ts} • Total releases: {count}</div>\\n    </div>\\n    <div class=\\\"controls\\\">\\n      <label for=\\\"search\\\" class=\\\"visually-hidden\\\">Search releases</label>\\n      <input id=\\\"search\\\" class=\\\"search\\\" placeholder=\\\"Search versions, highlights, fixes, notes\\\" aria-label=\\\"Search releases\\\">\\n      <div class=\\\"filters\\\" role=\\\"group\\\" aria-label=\\\"Filter releases\\\">\\n        <button data-filter=\\\"all\\\">All</button>\\n        <button data-filter=\\\"stable\\\">Stable</button>\\n        <button data-filter=\\\"prerelease\\\">Prerelease</button>\\n      </div>\\n    </div>\\n  </header>\\n  <p style=\\\"margin-top:12px\\\">Official source: <a href=\\\"https://github.com/github/app/releases\\\">github.com/github/app/releases</a></p>\\n  <section aria-live=\\\"polite\\\" class=\\\"grid\\\" id=\\\"cards\\\" ></section>\\n</main>\\n<script id=\\\"releases-data\\\" type=\\\"application/json\\\">{json_text}</script>\\n<script>\\n(function(){\\n  const releases = JSON.parse(document.getElementById('releases-data').textContent);\\n  const container = document.getElementById('cards');\\n  function esc(t){ const d=document.createElement('div'); d.textContent=t; return d.innerHTML }\\n  function formatDate(s){ if(!s) return ''; try{ const d=new Date(s); return d.toISOString().replace('T',' ').replace('Z',' UTC') }catch(e){ return s }}\\n  function makeCard(r){\\n    const el = document.createElement('article'); el.className='card'; el.tabIndex=0;\\n    const h = document.createElement('h3'); h.innerHTML = esc(r.name || r.tag) + (r.tag? (' <span class=\\\"badge\\\">'+esc(r.tag)+'</span>') : '');\\n    el.appendChild(h);\\n    const m = document.createElement('div'); m.className='meta'; m.textContent = (r.prerelease? 'Prerelease • ' : '') + formatDate(r.published || '');\\n    el.appendChild(m);\\n    const hlTitle = document.createElement('div'); hlTitle.className='section-title'; hlTitle.textContent = 'Highlights'; el.appendChild(hlTitle);\\n    const hl = document.createElement('p'); hl.textContent = r.highlights || 'None listed'; el.appendChild(hl);\\n    const fixesTitle = document.createElement('div'); fixesTitle.className='section-title'; fixesTitle.textContent='Fixes'; el.appendChild(fixesTitle);\\n    const fixes = document.createElement('p'); fixes.textContent = r.fixes || 'None listed'; el.appendChild(fixes);\\n    const a = document.createElement('a'); a.className='link'; a.href = r.link; a.textContent = 'View release notes'; a.target='_blank' ; a.rel='noopener noreferrer'; el.appendChild(a);\\n    return el;\\n  }\\n  function render(list){ container.innerHTML=''; list.forEach(r=>container.appendChild(makeCard(r))); document.querySelector('.count').textContent = 'Source: github/app Releases API • Generated UTC: '+(new Date().toISOString().replace(/\\\\.\\\\d+Z$/,'Z'))+' • Results: '+list.length; }\\n  function filterAndSearch(){ const q = (document.getElementById('search').value||'').toLowerCase(); const f = document.querySelector('[data-active]')?.dataset.active || 'all'; let out = releases.filter(r=>{\\n    if(f==='stable' && r.prerelease) return false;\\n    if(f==='prerelease' && !r.prerelease) return false;\\n    if(!q) return true;\\n    const hay = ((r.name||'')+' '+(r.tag||'')+' '+(r.highlights||'')+' '+(r.fixes||'')+' '+(r.link||'')).toLowerCase();\\n    return hay.indexOf(q) !== -1;\\n  });\\n  render(out);\\n}\\n  // initialize\\n  document.querySelectorAll('.filters button').forEach(b=>{ b.addEventListener('click', e=>{\\n    document.querySelectorAll('.filters button').forEach(x=>x.removeAttribute('data-active'));\\n    b.setAttribute('data-active','1'); b.dataset.active = b.dataset.filter || b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = (b.getAttribute('data-filter')||b.textContent.toLowerCase()); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); b.dataset.active = b.getAttribute('data-filter') || b.textContent.toLowerCase(); // defensive\\n    filterAndSearch();\\n  });\\n  // set All active by default\\n  const allBtn = document.querySelector('.filters button[data-filter=\\\"all\\\"]') || document.querySelector('.filters button'); if(allBtn){ allBtn.setAttribute('data-active','1'); }\\n  document.getElementById('search').addEventListener('input', filterAndSearch);\\n  // initial render\\n  render(releases);\\n})();\\n</script>\\n</body>\\n</html>\\n\\\"\\\"\\\"\\n\\n# ensure docs dir exists\\nos.makedirs(os.path.dirname(out), exist_ok=True)\\nwith open(out,'w',encoding='utf-8') as f:\\n    f.write(html_text)\\nprint(f'WROTE:{out}\\\\nCOUNT:{count}\\\\nNEWEST:{newest}')\\nPY\\n# Git prepare branch and commit\\nBRANCH=\\\"refresh-release-$(date -u +%Y%m%dT%H%M%SZ)\\\"\\n# configure user if needed\\ngit config user.email \\\"copilot@users.noreply.github.com\\\" || true\\ngit config user.name \\\"Copilot\\\" || true\\n# create branch, add and commit only the file\\ngit checkout -b \\\"$BRANCH\\\"\\ngit add docs/copilot-app-releases.html\\ngit commit -m \\\"refresh release page\\\" -m \\\"Release count: $(python3 -c 'import json;print(len(json.load(open(\\\"/tmp/gh-aw/agent/github-app-releases.json\\\"))) )')\\\\nNewest: $(head -n 1 /tmp/gh-aw/agent/github-app-releases.json | sed -n '1,1p')\\\\n\\\\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>\\\"\\n# create PR via safeoutputs (JSON body via jq -Rs)\\ncat > /tmp/gh-aw/agent/pr_body.md <<'MD'\\nRelease page refresh\\n\\nThis PR updates docs/copilot-app-releases.html with the latest release data imported from the official github/app Releases API.\\nMD\\njq -n --arg title \\\"refresh release page\\\" --arg body \\\"Release count: $(python3 - <<'PY'\\nimport json\\nprint(len(json.load(open('/tmp/gh-aw/agent/github-app-releases.json'))))\\nPY)\\nNewest: $(python3 - <<'PY'\\nimport json\\nr=json.load(open('/tmp/gh-aw/agent/github-app-releases.json'))\\nif r:\\n    print(r[0].get('tag_name') or r[0].get('name') or '')\\nelse:\\n    print('')\\nPY)\\\" --arg branch \\\"$BRANCH\\\" '{title:$title, body:$body, branch:$branch}' | safeoutputs create_pull_request .\\n\",\"description\":\"Generate HTML from JSON, commit to a branch, and open a pull request\",\"initial_wait\": 120}",
