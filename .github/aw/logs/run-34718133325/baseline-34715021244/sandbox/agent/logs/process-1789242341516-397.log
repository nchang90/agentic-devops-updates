              "arguments": "{\"command\":\"set -euo pipefail\\ncd /home/runner/work/Agentic-Workflows/Agentic-Workflows\\nPYTHONPATH=.\\npython3 - <<'PY'\\nimport json, re, html, sys, os, urllib.parse\\nfrom datetime import datetime\\n\\nsrc = '/tmp/gh-aw/agent/github-app-releases.json'\\nout = 'docs/copilot-app-releases.html'\\nwith open(src,'r',encoding='utf-8') as f:\\n    data = json.load(f)\\n# Deduplicate by numeric id\\nseen = {}\\nfor r in data:\\n    rid = r.get('id')\\n    if rid is None:\\n        continue\\n    if rid in seen:\\n        continue\\n    seen[rid] = r\\nreleases = list(seen.values())\\n# parse date helper\\ndef parse_dt(s):\\n    if not s: return None\\n    try:\\n        # ISO format, with Z\\n        if s.endswith('Z'):\\n            s = s[:-1] + '+00:00'\\n        return datetime.fromisoformat(s)\\n    except Exception:\\n        return None\\n\\n# sort by published_at desc, fallback created_at\\nreleases.sort(key=lambda r: (parse_dt(r.get('published_at')) or parse_dt(r.get('created_at')) or datetime.min), reverse=True)\\n\\n# helpers to extract sections\\nheading_re = re.compile(r'(?m)^(#{1,4})\\\\s*(.+)\\\\s*$')\\n\\ndef extract_section(body, cand_names):\\n    if not body:\\n        return None\\n    # normalize CRLF\\n    body = body.replace('\\\\r\\\\n','\\\\n')\\n    lines = body.split('\\\\n')\\n    # find heading indices\\n    indices = []\\n    for i,l in enumerate(lines):\\n        m = heading_re.match(l)\\n        if m:\\n            title = m.group(2).strip()\\n            indices.append((i,title))\\n    # find candidate section\\n    for idx,title in indices:\\n        for cand in cand_names:\\n            if title.lower().startswith(cand.lower()):\\n                # collect until next heading or end\\n                j = idx+1\\n                out_lines = []\\n                while j < len(lines) and not heading_re.match(lines[j]):\\n                    out_lines.append(lines[j])\\n                    j += 1\\n                text = '\\\\n'.join(out_lines).strip()\\n                if text:\\n                    return text\\n    return None\\n\\n# process each release into safe fields\\nprocessed = []\\nfor r in releases:\\n    name = r.get('name') or r.get('tag_name') or ''\\n    tag = r.get('tag_name') or ''\\n    raw_url = r.get('html_url') or ''\\n    # validate link\\n    link = 'https://github.com/github/app/releases'\\n    try:\\n        p = urllib.parse.urlparse(raw_url)\\n        if p.scheme == 'https' and p.netloc == 'github.com':\\n            link = raw_url\\n    except Exception:\\n        pass\\n    published = r.get('published_at') or r.get('created_at') or ''\\n    prerelease = bool(r.get('prerelease'))\\n    body = r.get('body') or ''\\n    highlights = extract_section(body, ['Highlights', \\\"What's new\\\", 'What’s new', 'Highlights:'])\\n    if not highlights:\\n        # fallback: first paragraph up to first blank line\\n        para = body.strip().split('\\\\n\\\\n',1)[0].strip()\\n        highlights = para if para else None\\n    fixes = extract_section(body, ['Fixed','Fixes','Fixed:','### Fixed','### Fixes'])\\n    # if fixes present, extract bullet list items\\n    fixes_summary = None\\n    if fixes:\\n        # collect up to first 6 bullet lines\\n        items = [line.strip('-* ') for line in fixes.splitlines() if line.strip().startswith(('-', '*'))]\\n        if not items:\\n            # maybe paragraph\\n            fixes_summary = fixes.strip()\\n        else:\\n            fixes_summary = '\\\\n'.join(items[:6])\\n    processed.append({\\n        'id': r.get('id'),\\n        'name': name,\\n        'tag': tag,\\n        'link': link,\\n        'published': published,\\n        'prerelease': prerelease,\\n        'highlights': highlights or '',\\n        'fixes': fixes_summary or ''\\n    })\\n\\n# generation timestamp and count\\ngen_ts = datetime.utcnow().replace(microsecond=0).isoformat() + 'Z'\\ncount = len(processed)\\nnewest = processed[0]['tag