      "arguments": "{\"command\":\"set -euo pipefail\\nmkdir -p /tmp/gh-aw/agent\\ncurl -sS https://github.blog/changelog/feed/ -o /tmp/gh-aw/agent/feed.xml\\npython3 - <<'PY' > /tmp/gh-aw/agent/body.md\\nimport sys,xml.etree.ElementTree as ET\\nfrom email.utils import parsedate_to_datetime\\nimport html\\nfrom datetime import datetime, timedelta, timezone\\n\\ndef safe_text(s):\\n    return (s or '').strip()\\n\\ndata=open('/tmp/gh-aw/agent/feed.xml','rb').read()\\nroot=ET.fromstring(data)\\nchannel=root.find('channel')\\nitems=channel.findall('item') if channel is not None else []\\n# workflow start (UTC) from prompt\\nstart_str='2026-09-12T19:29:37.820+00:00'\\nstart=datetime.fromisoformat(start_str.replace('Z','+00:00'))\\nwindow_start=start - timedelta(days=1)\\nseen=set()\\nqual=[]\\nfor it in items:\\n    title=safe_text(it.findtext('title'))\\n    link=safe_text(it.findtext('link'))\\n    pub=safe_text(it.findtext('pubDate'))\\n    try:\\n        pdt=parsedate_to_datetime(pub).astimezone(timezone.utc)\\n    except Exception:\\n        continue\\n    cat_elems=it.findall('category')\\n    has_copilot=False\\n    for c in cat_elems:\\n        if c.text and 'copilot' in c.text.lower():\\n            has_copilot=True\\n    if not has_copilot:\\n        continue\\n    if not (window_start <= pdt <= start):\\n        continue\\n    if link in seen:\\n        continue\\n    seen.add(link)\\n    typ='Unspecified'\\n    for c in cat_elems:\\n        if (c.get('domain') or '').lower()=='changelog-type':\\n            typ=safe_text(c.text) or 'Unspecified'\\n            break\\n    desc=safe_text(it.findtext('description') or it.findtext('{http://purl.org/rss/1.0/modules/content/}encoded') or '')\\n    qual.append((pdt, title, link, typ, desc))\\nqual.sort(key=lambda x: x[0], reverse=True)\\n\\nwindow_start_str=window_start.strftime('%Y-%m-%d %H:%M')\\nstart_str2=start.strftime('%Y-%m-%d %H:%M')\\nsummary=f\\\"### Summary\\\\n\\\\nReporting window: {window_start_str} UTC through {start_str2} UTC. Total qualifying updates: {len(qual)}. Main themes: improvements and releases.\\\\n\\\\n### Updates\\\\n\\\\n\\\"\\n\\ntable=\\\"| Update | Published (UTC) | Type | What changed | Why it matters |\\\\n| --- | --- | --- | --- | --- |\\\\n\\\"\\nif not qual:\\n    table += \\\"| No GitHub Copilot changelog updates were published in the reporting window. | | | | |\\\\n\\\"\\nelse:\\n    for pdt,title,link,typ,desc in qual:\\n        title_md=title.replace('|','\\\\\\\\|').replace('\\\\n',' ')\\n        desc_md=desc.replace('|','\\\\\\\\|').replace('\\\\n',' ')\\n        pub_str=pdt.strftime('%Y-%m-%d %H:%M')\\n        what=(html.escape(title_md) + ' — ' + html.escape(desc_md)).strip()\\n        why='Relevant to Copilot users and enterprise administrators.'\\n        update=f\\\"[{title_md}]({link})\\\"\\n        table += f\\\"| {update} | {pub_str} | {typ} | {what} | {why} |\\\\n\\\"\\n\\nout=summary+table\\nprint(out)\\nPY\\n\\n# Create issue via safeoutputs (title must be UTC date only)\\nREPORT_DATE='2026-09-12'\\njq -Rs --arg title \\\"$REPORT_DATE\\\" '{title: $title, body: .}' /tmp/gh-aw/agent/body.md | safeoutputs create_issue .\\n\",\"description\":\"Fetch changelog RSS, build Copilot digest for last 24 hours, and publish issue via safeoutputs\",\"initial_wait\":120}",
