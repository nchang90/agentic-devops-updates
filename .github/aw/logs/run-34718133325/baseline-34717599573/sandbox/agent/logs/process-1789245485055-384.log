      "arguments": "{\"path\":\"/tmp/gh-aw/agent/generate.js\",\"file_text\":\"const fs = require('fs');\\nconst path = require('path');\\nconst inPath = '/tmp/gh-aw/agent/github-app-releases.json';\\nconst outPath = path.resolve(process.cwd(), 'docs/copilot-app-releases.html');\\nfunction escapeHtml(s){\\n  if(!s) return '';\\n  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\\\"/g,'&quot;').replace(/'/g,'&#39;');\\n}\\nfunction firstParagraph(text){\\n  if(!text) return '';\\n  // remove HTML tags\\n  const stripped = String(text).replace(/<[^>]*>/g,'').trim();\\n  const para = stripped.split(/\\\\n\\\\s*\\\\n/)[0].trim();\\n  // truncate to 280 chars\\n  return para.length>280?para.slice(0,277)+'...':para;\\n}\\nlet raw;\\ntry{ raw = fs.readFileSync(inPath,'utf8'); }catch(e){ console.error('FAIL READ', e.message); process.exit(2); }\\nlet items;\\ntry{ items = JSON.parse(raw); }catch(e){ console.error('FAIL PARSE', e.message); process.exit(3); }\\nif(!Array.isArray(items)) items = items.releases || items;\\n// dedupe by id\\nconst byId = new Map();\\nfor(const it of items){ if(!it || !it.id) continue; if(!byId.has(it.id)) byId.set(it.id, it); }\\nlet releases = Array.from(byId.values());\\n// sort by published_at or created_at desc\\nreleases.sort((a,b)=>{\\n  const ta = (a.published_at||a.created_at||'');\\n  const tb = (b.published_at||b.created_at||'');\\n  return (tb||'').localeCompare(ta||'');\\n});\\nconst releaseCount = releases.length;\\nconst newest = releases[0] ? (releases[0].tag_name || releases[0].name || '') : '';\\nconst generatedAt = new Date().toISOString();\\n\\nfunction isoUTC(d){ if(!d) return ''; try{ return new Date(d).toISOString().replace('T',' ').replace('Z',' UTC'); }catch(e){return escapeHtml(d);} }\\n\\n// Build HTML\\nconst html = [];\\nhtml.push('<!doctype html>');\\nhtml.push('<html lang=\\\"en\\\">');\\nhtml.push('<head>');\\nhtml.push('<meta charset=\\\"utf-8\\\">');\\nhtml.push('<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">');\\nhtml.push('<title>GitHub App Releases — Copilot</title>');\\nhtml.push('<style>');\\nhtml.push('body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;margin:0;padding:0;background:#f6f8fa;color:#0b1220}');\\nhtml.push('.container{max-width:980px;margin:24px auto;padding:16px}');\\nhtml.push('.header{display:flex;align-items:center;justify-content:space-between;gap:12px}');\\nhtml.push('.meta{color:#586069;font-size:13px}');\\nhtml.push('.controls{display:flex;gap:8px;align-items:center;margin-top:12px}');\\nhtml.push('.card{background:#fff;border:1px solid #e1e4e8;border-radius:6px;padding:12px;margin:12px 0}');\\nhtml.push('.badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px;border:1px solid #d1d5da;background:#fafbfc}');\\nhtml.push('.pre{background:#fff7e6;border-color:#ffe8a1}');\\nhtml.push('.stable{background:#edfdf3;border-color:#c6f6d5}');\\nhtml.push('.name{font-weight:600;font-size:16px;margin:0}');\\nhtml.push('.date{color:#586069;font-size:13px}');\\nhtml.push('.highlights{margin-top:8px;color:#24292e}');\\nhtml.push('.empty{padding:40px;text-align:center;color:#586069}');\\nhtml.push('.search{flex:1;padding:8px;border:1px solid #d1d5da;border-radius:6px}');\\nhtml.push('.filters{display:flex;gap:6px}');\\nhtml.push('</style>');\\nhtml.push('</head>');\\nhtml.push('<body>');\\nhtml.push('<main class=\\\"container\\\" id=\\\"main\\\">');\\nhtml.push('<div class=\\\"header\\\">');\\nhtml.push('<div>');\\nhtml.push('<h1 style=\\\"margin:0\\\">Copilot App Releases</h1>');\\nhtml.push(`<div class=\\\"meta\\\">Generated UTC: ${escapeHtml(generatedAt)} — ${releaseCount} release${releaseCount===1?'':'s'} — <a href=\\\"https://github.com/github/app/releases\\\">Official releases page</a></div>`);\\nhtml.push('</div>');\\nhtml.push('<div style=\\\"text-align:right\\\">');\\nhtml.push(`<div class=\\\"meta\\\">Newest: ${escapeHtml(newest)}</div>`);\\nhtml.push('</div>');\\nhtml.push('</div>');\\n\\n// Controls\\nhtml.push('<div class=\\\"controls\\\" aria-hidden=\\\"false\\\">');\\nhtml.push('<input id=\\\"q\\\" class=\\\"search\\\" placeholder=\\\"Search releases\\\">');\\nhtml.push('<div class=\\\"filters\\\">');\\nhtml.push('<label><input type=\\\"radio\\\" name=\\\"f\\\" value=\\\"all\\\" checked> All</label>');\\nhtml.push('<label><input type=\\\"radio\\\" name=\\\"f\\\" value=\\\"stable\\\"> Stable</label>');\\nhtml.push('<label><input type=\\\"radio\\\" name=\\\"f\\\" value=\\\"prerelease\\\"> Prerelease</label>');\\nhtml.push('</div>');\\nhtml.push('<div id=\\\"count\\\" style=\\\"min-width:84px;text-align:right;font-size:13px;color:#586069\\\">'+releaseCount+' results</div>');\\nhtml.push('</div>');\\n\\nif(releases.length===0){\\n  html.push('<div class=\\\"empty\\\">No releases available.</div>');\\n}\\n\\n// Render each release directly so content visible without JS\\nfor(const r of releases){\\n  const name = r.name||r.tag_name||'(untitled)';\\n  const date = r.published_at||r.created_at||'';\\n  const dateIso = isoUTC(date);\\n  const isPrerelease = !!r.prerelease;\\n  const highlights = firstParagraph(r.body || r.body_text || r.notes || r.body_html);\\n  html.push(`<article class=\\\"card\\\" data-prerelease=\\\"${isPrerelease?1:0}\\\" data-name=\\\"${escapeHtml(name.toLowerCase())}\\\">`);\\n  html.push(`<div style=\\\"display:flex;justify-content:space-between;align-items:flex-start;gap:12px\\\">`);\\n  html.push(`<div><p class=\\\"name\\\">${escapeHtml(name)}</p><div class=\\\"date\\\">${escapeHtml(dateIso)}</div></div>`);\\n  html.push(`<div><span class=\\\"badge ${isPrerelease? 'pre':''} \\\">${isPrerelease? 'Prerelease':'Stable'}</span></div>`);\\n  html.push('</div>');\\n  if(highlights) html.push(`<div class=\\\"highlights\\\">${escapeHtml(highlights)}</div>`);\\n  html.push('</article>');\\n}\\n\\n// Inline JS for search and filters (progressive enhancement)\\nhtml.push('<script>');\\nhtml.push(\\\"(function(){\\\\n  const q = document.getElementById('q');\\\\n  const count = document.getElementById('count');\\\\n  const cards = Array.from(document.querySelectorAll('.card'));\\\\n  function update(){\\\\n    const term = q.value.trim().toLowerCase();\\\\n    const filter = document.querySelector('input[name=\\\\\\\\\\\"f\\\\\\\\\\\"]:checked').value;\\\\n    let visible = 0;\\\\n    for(const c of cards){\\\\n      const name = c.getAttribute('data-name') || '';\\\\n      const prerelease = c.getAttribute('data-prerelease') === '1';\\\\n      if(filter==='stable' && prerelease) { c.style.display='none'; continue; }\\\\n      if(filter==='prerelease' && !prerelease) { c.style.display='none'; continue; }\\\\n      if(term && name.indexOf(term)===-1){ c.style.display='none'; continue; }\\\\n      c.style.display='block'; visible++;\\\\n    }\\\\n    count.textContent = visible + ' results';\\\\n  }\\\\n  q.addEventListener('input', update);\\\\n  document.querySelectorAll('input[name=\\\\\\\\\\\"f\\\\\\\\\\\"]').forEach(el=>el.addEventListener('change', update));\\\\n})();\\\")\\nhtml.push('</script>');\\n\\nhtml.push('</main>');\\nhtml.push('</body>');\\nhtml.push('</html>');\\n\\ntry{\\n  fs.mkdirSync(path.dirname(outPath), { recursive:true });\\n  fs.writeFileSync(outPath, html.join('\\\\n'), 'utf8');\\n  console.log('WROTE', outPath, 'releases:', releaseCount);\\n  process.exit(0);\\n}catch(e){ console.error('FAIL WRITE', e.message); process.exit(4); }\\n\"}",
