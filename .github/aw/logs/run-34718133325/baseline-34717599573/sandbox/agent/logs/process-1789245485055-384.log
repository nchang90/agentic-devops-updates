0;\\n    for(const c of cards){\\n      const name = c.getAttribute('data-name') || '';\\n      const prerelease = c.getAttribute('data-prerelease') === '1';\\n      if(filter==='stable' && prerelease) { c.style.display='none'; continue; }\\n      if(filter==='prerelease' && !prerelease) { c.style.display='none'; continue; }\\n      if(term && name.indexOf(term)===-1){ c.style.display='none'; continue; }\\n      c.style.display='block'; visible++;\\n    }\\n    count.textContent = visible + ' results';\\n  }\\n  q.addEventListener('input', update);\\n  document.querySelectorAll('input[name=\\\\\"f\\\\\"]').forEach(el=>el.addEventListener('change', update));\\n})();\")\nhtml.push('</script>');\n\nhtml.push('</main>');\nhtml.push('</body>');\nhtml.push('</html>');\n\ntry{\n  fs.mkdirSync(path.dirname(outPath), { recursive:true });\n  fs.writeFileSync(outPath, html.join('\\n'), 'utf8');\n  console.log('WROTE', outPath, 'releases:', releaseCount);\n  process.exit(0);\n}catch(e){ console.error('FAIL WRITE', e.message); process.exit(4); }\n"
