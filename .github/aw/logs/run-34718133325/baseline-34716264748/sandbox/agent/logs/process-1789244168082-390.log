      "arguments": "{\"command\":\"set -euo pipefail\\nPY=/tmp/gh-aw/agent/generate_releases_page.py\\nOUT_TMP=/tmp/gh-aw/agent/copilot-app-releases.html\\nJSON_PATH=/tmp/gh-aw/agent/github-app-releases.json\\nDEST=docs/copilot-app-releases.html\\n\\ncat > \\\"$PY\\\" <<'PY'\\nimport json,html,sys,datetime,re\\nfrom pathlib import Path\\np=Path(\\\"\\\"\\\"\\\"+JSON_PATH+\\\"\\\"\\\"\\\")\\nif not p.exists():\\n    print('JSON input missing', file=sys.stderr); sys.exit(2)\\nraw=json.loads(p.read_text())\\n# Expect a list of releases or an object with 'releases' key\\nif isinstance(raw, dict) and 'releases' in raw and isinstance(raw['releases'], list):\\n    items=raw['releases']\\nelif isinstance(raw, list):\\n    items=raw\\nelse:\\n    # try common key names\\n    items = raw.get('items') if isinstance(raw, dict) else []\\n    if items is None: items = []\\n\\n# normalize and dedupe by id\\nseen=set()\\nnormalized=[]\\nfor r in items:\\n    rid = r.get('id') or r.get('node_id') or (r.get('tag_name') + '::' + (r.get('published_at') or r.get('created_at',''))) if isinstance(r,dict) else None\\n    if rid in seen: continue\\n    seen.add(rid)\\n    name = r.get('name') or r.get('tag_name') or ''\\n    body = r.get('body') or r.get('notes') or ''\\n    pub = r.get('published_at') or r.get('created_at') or ''\\n    created = r.get('created_at') or ''\\n    date = pub or created or ''\\n    prerelease = bool(r.get('prerelease'))\\n    html_url = r.get('html_url') or r.get('url') or ''\\n    normalized.append({'id':rid,'name':name,'body':body,'date':date,'prerelease':prerelease,'html_url':html_url})\\n\\n# parse date for sorting; fallback to empty string\\ndef parse_dt(s):\\n    if not s: return datetime.datetime.min\\n    for fmt in (\\\"%Y-%m-%dT%H:%M:%SZ\\\",\\\"%Y-%m-%dT%H:%M:%S%z\\\",\\\"%Y-%m-%dT%H:%M:%S.%fZ\\\",\\\"%Y-%m-%d\\\"):\\n        try:\\n            return datetime.datetime.strptime(s,fmt)\\n        except Exception:\\n            pass\\n    try:\\n        return datetime.datetime.fromisoformat(s)\\n    except Exception:\\n        return datetime.datetime.min\\n\\nnormalized.sort(key=lambda x: parse_dt(x['date']), reverse=True)\\n\\n# sanitize and prepare highlights and enforce link policy\\nSAFE_LINK_PREFIX = 'https://github.com/'\\nfor r in normalized:\\n    # highlight: first non-empty line of body\\n    txt = r['body'] or ''\\n    txt = txt.strip()\\n    if not txt:\\n        h = ''\\n    else:\\n        # collapse whitespace and take first paragraph/200 chars\\n        para = re.split(r\\\"\\\\n\\\\s*\\\\n\\\", txt)[0]\\n        one = ' '.join(para.split())\\n        h = one[:400]\\n    r['highlight'] = h\\n    # link policy\\n    url = r.get('html_url','') or ''\\n    if url.startswith(SAFE_LINK_PREFIX):\\n        r['safe_url']=url\\n    else:\\n        r['safe_url']='https://github.com/github/app/releases'\\n    # ensure name is string\\n    r['name'] = str(r.get('name') or '')\\n\\n# build HTML\\ngen_time = datetime.datetime.utcnow().replace(microsecond=0).isoformat() + 'Z'\\nrelease_count = len(normalized)\\nnewest = normalized[0]['name'] if normalized else ''\\n\\n# prepare JSON data for embedding\\nj = json.dumps([{'id':r['id'],'name':r['name'],'date':r['date'],'prerelease':r['prerelease'],'url':r['safe_url'],'highlight':r['highlight']} for r in normalized], ensure_ascii=False)\\n# avoid closing </script>\\nj = j.replace('</script>', '<\\\\\\\\/script>')\\n\\nhtml_parts = []\\nhtml_parts.append('<!doctype html>')\\nhtml_parts.append('<html lang=\\\"en\\\">')\\nhtml_parts.append('<head>')\\nhtml_parts.append('<meta charset=\\\"utf-8\\\">')\\nhtml_parts.append('<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">')\\nhtml_parts.append(f'<title>Copilot App Releases — generated {gen_time}</title>')\\n# inline CSS (concise)\\nhtml_parts.append('<style> :root{--bg:#fff;--fg:#111;--card:#f7f7fb;--muted:#555} [data-theme=\\\"dark\\\"]{--bg:#0b0b0f;--fg:#e6eef8;--card:#0f1720;--muted:#9aaabe} body{background:var(--bg);color:var(--fg);font-family:Inter,Segoe UI,system-ui,Arial;margin:0;padding:32px} .container{max-width:1000px;margin:0 auto} header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px} h1{font-size:20px;margin:0} .meta{color:var(--muted);font-size:13px} .controls{display:flex;gap:8px;align-items:center} input[type=search]{padding:8px;border-radius:8px;border:1px solid #ccc;background:transparent} .filters button{padding:6px 10px;border-radius:8px;border:1px solid #ccc;background:transparent;cursor:pointer} .count{font-weight:600} .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-top:18px} .card{background:var(--card);padding:12px;border-radius:10px;border:1px solid rgba(0,0,0,0.04)} .card h3{margin:0 0 8px 0;font-size:15px} .badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px;background:#e6f0ff;color:#0b4; margin-left:8px} .link{font-size:13px;color:inherit;text-decoration:underline} .empty{padding:40px;text-align:center;color:var(--muted)} @media (prefers-color-scheme:dark){:root{--bg:#0b0b0f;--fg:#e6eef8;--card:#0f1720;--muted:#9aaabe}} </style>')\\nhtml_parts.append('</head>')\\nhtml_parts.append('<body data-theme=\\\"light\\\">')\\nhtml_parts.append('<div class=\\\"container\\\">')\\nhtml_parts.append('<header>')\\nhtml_parts.append('<div><h1>Copilot App Releases</h1><div class=\\\"meta\\\">Generated UTC ' + html.escape(gen_time) + ' • <span class=\\\"count\\\">' + str(release_count) + '</span> releases • <a href=\\\"https://github.com/github/app/releases\\\">Official releases</a></div></div>')\\nhtml_parts.append('<div class=\\\"controls\\\">')\\nhtml_parts.append('<input id=\\\"search\\\" type=\\\"search\\\" placeholder=\\\"Search releases\\\" aria-label=\\\"Search releases\\\">')\\nhtml_parts.append('<div class=\\\"filters\\\" role=\\\"tablist\\\" aria-label=\\\"Filter releases\\\">')\\nhtml_parts.append('<button data-filte