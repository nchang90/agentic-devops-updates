ById(\\\"empty\\\");const q=document.getElementById(\\\"search\\\");const filters=document.querySelectorAll('[data-filter]');const themeToggle=document.getElementById(\\\"themeToggle\\\"); function renderList(list){{cards.innerHTML=\\\"\\\"; if(!list.length){{empty.style.display='block'; return}} empty.style.display='none'; for(const r of list){{const d=document.createElement('div');d.className='card'; const h=document.createElement('h3'); const a=document.createElement('a'); a.textContent=r.name||'(no title)'; a.href = r.url||'https://github.com/github/app/releases'; a.target='_blank'; a.rel='noopener noreferrer'; a.className='link'; h.appendChild(a); if(r.prerelease){{const b=document.createElement('span');b.textContent='PRE'; b.className='badge'; h.appendChild(b)}} d.appendChild(h); const p=document.createElement('p'); p.textContent = r.highlight || ''; p.style.margin='0'; p.style.fontSize='13px'; d.appendChild(p); const meta=document.createElement('div'); meta.className='meta'; meta.textContent = r.date || ''; meta.style.fontSize='12px'; meta.style.marginTop='8px'; d.appendChild(meta); cards.appendChild(d)}} }} function applyFilter(){{const term=q.value.trim().toLowerCase(); const active=document.querySelector('[data-filter][aria-pressed=\\\"true\\\"]').getAttribute('data-filter'); let list=releases.slice(); if(active==='prerelease') list=list.filter(x=>x.prerelease); else if(active==='stable') list=list.filter(x=>!x.prerelease); if(term){{list=list.filter(x=>((x.name||'')+ ' ' + (x.highlight||'')).toLowerCase().includes(term))}} renderList(list)}} filters.forEach(btn=>btn.addEventListener('click',e=>{{filters.forEach(b=>b.setAttribute('aria-pressed','false')); e.currentTarget.setAttribute('aria-pressed','true'); applyFilter()}})) q.addEventListener('input',applyFilter); themeToggle.addEventListener('click',()=>{{const el=document.body; const cur=el.getAttribute('data-theme')||'light'; el.setAttribute('data-theme', cur==='light'?'dark':'light')}}) releases = JSO