              "name": "bash",
              "arguments": "{\"command\":\"python3 - <<'PY'\\nimport json, sys, os, html, datetime, subprocess\\nJPATH = '/tmp/gh-aw/agent/github-app-releases.json'\\nOUTPATH = '/home/runner/work/Agentic-Workflows/Agentic-Workflows/docs/copilot-app-releases.html'\\nBRANCH_PREFIX = 'refresh-release-page'\\n\\ndef load_json(path):\\n    with open(path, 'r', encoding='utf-8') as f:\\n        return json.load(f)\\n\\ntry:\\n    data = load_json(JPATH)\\nexcept Exception as e:\\n    print(json.dumps({'status':'error','error':f'failed to load json: {e}'}))\\n    sys.exit(0)\\n\\n# Normalize: if it's an object with items under a key, try common keys\\nreleases = []\\nif isinstance(data, list):\\n    releases = data\\nelif isinstance(data, dict):\\n    # find list-like value\\n    for k in ('releases','items','data','results'):\\n        if k in data and isinstance(data[k], list):\\n            releases = data[k]\\n            break\\n    if not releases:\\n        # If dict of id->release\\n        if all(isinstance(v, dict) for v in data.values()):\\n            releases = list(data.values())\\n\\n# Filter to dicts\\nreleases = [r for r in releases if isinstance(r, dict)]\\n\\n# Deduplicate by id\\nseen = set()\\nuniq = []\\nfor r in releases:\\n    rid = r.get('id') or r.get('node_id') or (r.get('tag_name') + '|' + str(r.get('published_at',''))) if r.get('tag_name') else None\\n    if rid is None:\\n        # generate from name+date\\n        rid = (r.get('name') or r.get('tag_name') or '') + '|' + (r.get('published_at') or r.get('created_at') or '')\\n    if rid in seen:\\n        continue\\n    seen.add(rid)\\n    uniq.append(r)\\nreleases = uniq\\n\\n# Sorting by published_at or created_at descending\\ndef get_date(r):\\n    for k in ('published_at','published','created_at','created'):\\n        v = r.get(k)\\n        if v:\\n            return v\\n    return ''\\nreleases.sort(key=get_date, reverse=True)\\n\\n# Build summary list for JS (escape via json.dumps later)\\njs_items = []\\ncards_html = []\\nfor r in releases:\\n    rid = r.get('id')\\n    name = r.get('name') or r.get('tag_name') or ''\\n    tag = r.get('tag_name') or ''\\n    body = r.get('body') or r.get('body_text') or r.get('notes') or ''\\n    # short highlights: first non-empty paragraph up to 240 chars\\n    highlights = ''\\n    for p in [seg.strip() for seg in body.split('\\\\n\\\\n') if seg.strip()]:\\n        highlights = p\\n        break\\n    if highlights:\\n        highlights = highlights.replace('\\\\n',' ')[:480]\\n    date = get_date(r)\\n    # Decide stable/prerelease: use 'prerelease' or 'draft'\\n    prerelease = bool(r.get('prerelease') or r.get('draft'))\\n    url = r.get('html_url') or r.get('url') or ''\\n    # Only allow https://github.com/ links; otherwise fallback to https://github.com/github/app/releases\\n    if not (url.startswith('https://github.com/')):\\n        url = 'https://github.com/github/app/releases'\\n    js_items.append({'id':rid,'name':name,'tag':tag,'highlights':highlights,'date':date,'prerelease':prerelease,'url':url})\\n\\n    # Escape content for HTML\\n    esc_name = html.escape(name) or html.escape(tag) or 'untitled'\\n    esc_high = html.escape(highlights)\\n    esc_date = html.escape(date)\\n    badge = '<span class=\\\"badge prerelease\\\">prerelease</span>' if prerelease else '<span class=\\\"badge stable\\\">stable</span>'\\n    card = f'''<article class=\\\"card\\\" data-prerelease=\\\"{str(prerelease).lower()}\\\">\\n  <h3><a href=\\\"{html.escape(url)}\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">{esc_name}</a> <small class=\\\"tag\\\">{html.escape(tag)}</small></h3>\\n  <div class=\\\"meta\\\">{esc_date} {badge}</div>\\n  <p class=\\\"highlights\\\">{esc_high}</p>\\n</article>'''\\n    cards_html.append(card)\\n\\n# Build final HTML\\nutcnow = datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')\\ncount = len(releases)\\nnewest = releases[0].get('name') or releases[0].get('tag_name') if releases else ''\\n\\nhtml_doc = f'''<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<title>Copilot App Releases</title>\\n<style>\\n:root{{--bg:#fff;--fg:#111;--muted:#555;--card:#f6f8fa;--accent:#0366d6}}\\n@media(prefers-color-scheme:dark){{:root{{--bg:#0d1117;--fg:#c9d1d9;--muted:#8b949e;--card:#161b22;--accent:#58a6ff}}}}\\nbody{{background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,Segoe UI,Roboto,Segoe UI Emoji,Helvetica,Arial;line-height:1.4;margin:0;padding:1rem}}\\n.header{{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}}\\n.controls{display:flex;gap:.5rem;align-items:center}\\ninput.search{{padding:.5rem;border:1px solid #ccc;border-radius:6px;min-width:220px}}\\nselect.filter{{padding:.4rem;border-radius:6px}}\\n.count{{color:var(--muted)}}\\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;margin-top:1rem}\\n.card{background:var(--card);padding:1rem;border-radius:8px;border:1px solid rgba(0,0,0,0.05)}\\n.card h3{margin:.1rem 0 0.4rem;font-size:1rem}\\n.card .tag{font-size:.8rem;color:var(--muted);margin-left:.4rem}\\n.meta{font-size:.8rem;color:var(--muted);margin-bottom:.5rem}\\n.badge{display:inline-block;padding:.15rem .4rem;border-radius:999px;font-size:.7rem;margin-left:.4rem}\\n.badge.prerelease{background:#f0ad4e;color:#2a1a00}\\n.badge.stable{background:#dff0d8;color:#1b3a12}\\n.empty{padding:2rem;text-align:center;color:var(--muted)}\\n</style>\\n</head>\\n<body>\\n<header class=\\\"header\\\">\\n  <div>\\n    <h1 style=\\\"margin:.1rem 0\\\">Copilot App Releases</h1>\\n    <div class=\\\"meta\\\">Generated: {utcnow} (UTC) • <a href=\\\"https://github.com/github/app/releases\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">Official releases</a></div>\\n  </div>\\n  <div class=\\\"controls\\\">\\n    <input class=\\\"search\\\" id=\\\"search\\\" placeholder=\\\"Search releases...\\\" aria-label=\\\"Search releases\\\">\\n    <select class=\\\"filter\\\" id=\\\"filter\\\" aria-label=\\\"Filter\\\">\\n      <option value=\\\"all\\\">All</option>\\n      <option value=\\\"stable\\\">Stable</option>\\n      <option value=\\\"prerelease\\\">Prerelease</option>\\n    </select>\\n    <div class=\\\"count\\\" id=\\\"count\\\">{count} releases</div>\\n  </div>\\n</header>\\n<main>\\n  <section id=\\\"results\\\" class=\\\"grid\\\">\\n    {''.join(cards_html)}\\n  </section>\\n  <div id=\\\"empty\\\" class=\\\"empty\\\" style=\\\"display:none\\\">No releases match your search or filter.</div>\\n</main>\\n<script>\\n// Data for search (escaped server-side)\\nconst releases = {json.dumps(js_items)};\\nconst searchInput = document.getElementById('search');\\nconst filterSelect = document.getElementById('filter');\\nconst results = document.getElementById('results');\\nconst countEl = document.getElementById('count');\\nconst empty = document.getElementById('empty');\\n\\nfunction render(list){\\n  results.innerHTML = list.map(r=>{\\n    const name = escapeHtml(r.name||r.tag||'untitled');\\n    const url = r.url;\\n    const tag = escapeHtml(r.tag||'');\\n    const date = escapeHtml(r.date||'');\\n    const badge = r.prerelease? '<span class=\\\"badge prerelease\\\">prerelease</span>':'<span class=\\\"badge stable\\\">stable</span>';\\n    const highlights = escapeHtml(r.highlights||'');\\n    return `<article class=\\\"card\\\" data-prerelease=\\\"${r.prerelease}\\\"><h3><a href=\\\"${url}\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">${name}</a> <small class=\\\"tag\\\">${tag}</small></h3><div class=\\\"meta\\\">${date} ${badge}</div><p class=\\\"highlights\\\">${highlights}</p></article>`\\n  }).join('');\\n  countEl.textContent = list.length + ' releases';\\n  empty.style.display = list.length? 'none':'block';\\n}\\n\\nfunction escapeHtml(s){ return s.replace(/[&<>\\\\\\\"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;'}[c])); }\\n\\nfunction applyFilters(){\\n  const q = searchInput.value.trim().toLowerCase();\\n  const f = filterSelect.value;\\n  const filtered = releases.filter(r=>{\\n    if(f==='stable' && r.prerelease) return false;\\n    if(f==='prerelease' && !r.prerelease) return false;\\n    if(!q) return true;\\n    return (r.name||r.tag||'').toLowerCase().includes(q) || (r.highlights||'').toLowerCase().includes(q);\\n  });\\n  render(filtered);\\n}\\n\\nsearchInput.addEventListener('input', applyFilters);\\nfilterSelect.addEventListener('change', applyFilters);\\n</script>\\n</body>\\n</html>\\n'''\\n\\n# Compare with existing\\nold = None\\nif os.path.exists(OUTPATH):\\n    with open(OUTPATH,'r',encoding='utf-8') as f:\\n        old = f.read()\\n\\nif old is not None and old == html_doc:\\n    print(json.dumps({'status':'unchanged','count':count}))\\n    sys.exit(0)\\n\\n# Write file\\nwith open(OUTPATH,'w',encoding='utf-8') as f:\\n    f.write(html_doc)\\n\\n# Create git branch and commit\\n# Determine current branch\\ntry:\\n    cur = subprocess.check_output(['git','branch','--show-current'],cwd='/home/runner/work/Agentic-Workflows/Agentic-Workflows').decode().strip()\\nexcept Exception:\\n    cur = 'HEAD'\\nbranch = f\\\"{BRANCH_PREFIX}-{datetime.datetime.utcnow().strftime('%Y%m%d%H%M%S')}\\\"\\ntry:\\n    subprocess.check_call(['git','config','user.email','copilot@example.com'],cwd='/home/runner/work/Agentic-Workflows/Agentic-Workflows')\\n    subprocess.check_call(['git','config','user.name','Copilot'],cwd='/home/runner/work/Agentic-Workflows/Agentic-Workflows')\\n    subprocess.check_call(['git','checkout','-b',branch],cwd='/home/runner/work/Agentic-Workflows/Agentic-Workflows')\\n    subprocess.check_call(['git','add','docs/copilot-app-releases.html'],cwd='/home/runner/work/Agentic-Workflows/Agentic-Workflows')\\n    commit_msg = f\\\"refresh release page\\\\n\\\\nUpdate copilot app releases page.\\\\n\\\\nCo-authored-by: