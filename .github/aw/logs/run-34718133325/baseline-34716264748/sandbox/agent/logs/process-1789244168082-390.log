  return datetime.datetime.fromisoformat(s)\\n    except Exception:\\n        return datetime.datetime.min\\n\\nnormalized.sort(key=lambda x: parse_dt(x['date']), reverse=True)\\n\\n# sanitize and prepare highlights and enforce link policy\\nSAFE_LINK_PREFIX = 'https://github.com/'\\nfor r in normalized:\\n    # highlight: first non-empty line of body\\n    txt = r['body'] or ''\\n    txt = txt.strip()\\n    if not txt:\\n        h = ''\\n    else:\\n        # collapse whitespace and take first paragraph/200 chars\\n        para = re.split(r\\\"\\\\n\\\\s*\\\\n\\\", txt)[0]\\n        one = ' '.join(para.split())\\n        h = one[:400]\\n    r['highlight'] = h\\n    # link policy\\n    url = r.get('html_url','') or ''\\n    if url.startswith(SAFE_LINK_PREFIX):\\n        r['safe_url']=url\\n    else:\\n        r['safe_url']='https://github.com/github/app/releases'\\n    # ensure name is string\\n    r['name'] = str(r.get('name') or '')\\n\\n# build HTML\\ngen_time = datetime.datetime.utcnow().replace(microsecond=0).isoformat() + 'Z'\\nrelease_count = len(normalized)\\nnewest = normalized[0]['name'] if normalized else ''\\n\\n# prepare JSON data for embedding\\nj = json.dumps([{'id':r['id'],'name':r['name'],'date':r['date'],'prerelease':r['prerelease'],'url':r['safe_url'],'highlight':r['highlight']} for r in normalized], ensure_ascii=False)\\n# avoid closing </script>\\nj = j.replace('</script>', '<\\\\\\\\/script>')\\n\\nhtml_parts = []\\nhtml_parts.append('<!doctype html>')\\nhtml_parts.append('<html lang=\\\"en\\\">')\\nhtml_parts.append('<head>')\\nhtml_parts.append('<meta charset=\\\"utf-8\\\">')\\nhtml_parts.append('<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">')\\nhtml_parts.append(f'<title>Copilot App Releases — generated {gen_time}</title>')\\n# inline CSS (concise)\\nhtml_parts.append('<style> :root{--bg:#fff;--fg:#111;--card:#f7f7fb;--muted:#555} [data-theme=\\\"dark\\\"]{--bg:#0b0b0f;--fg:#e6eef8;--card:#0f1720;--muted:#9aaabe} body{background:var(--bg);color:var(--fg);font-family:Inter,Segoe UI,system-ui,Arial;margin:0;padding:32px} .container{max-width:1000px;margin:0 auto} header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px} h1{font-size:20px;margin:0} .meta{color:var(--muted);font-size:13px} .controls{display:flex;gap:8px;align-items:center} input[type=search]{padding:8px;border-radius:8px;border:1px solid #ccc;background:transparent} .filters button{padding:6px 10px;border-radius:8px;border:1px solid #ccc;background:transparent;cursor:pointer} .count{font-weight:600} .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-top:18px} .card{background:var(--card);padding:12px;border-radius:10px;border:1px solid rgba(0,0,0,0.04)} .card h3{margin:0 0 8px 0;font-size:15px} .badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px;background:#e6f0ff;color:#0b4; margin-left:8px} .link{font-size:13px;color:inherit;text-decoration:underline} .empty{padding:40px;text-align:center;color:var(--muted)} @media (prefers-color-scheme:dark){:root{--bg:#0b0b0f;--fg:#e6eef8;--card:#0f1720;--muted:#9aaabe}} </style>')\\nhtml_parts.append('</head>')\\nhtml_parts.append('<body data-theme=\\\"light\\\">')\\nhtml_parts.append('<div class=\\\"container\\\">')\\nhtml_parts.append('<header>')\\nhtml_parts.append('<div><h1>Copilot App Releases</h1><div class=\\\"meta\\\">Generated UTC ' + html.escape(gen_time) + ' • <span class=\\\"count\\\">' + str(release_count) + '</span> releases • <a href=\\\"https://github.com/github/app/releases\\\">Official releases</a></div></div>')\\nhtml_parts.append('<div class=\\\"controls\\\">')\\nhtml_parts.append('<input id=\\\"search\\\" type=\\\"search\\\" placeholder=\\\"Search releases\\\" aria-label=\\\"Search releases\\\">')\\nhtml_parts.append('<div class=\\\"filters\\\" role=\\\"tablist\\\" aria-label=\\\"Filter releases\\\">')\\nhtml_parts.append('<button data-filter=\\\"all\\\" aria-pressed=\\\"true\\\">All</button>')\\nhtml_parts.append('<button data-filter=\\\"stable\\\">Stable</button>')\\nhtml_parts.append('<button data-filter=\\\"prerelease\\\">Prerelease</button>')\\nhtml_parts.append('</div>')\\nhtml_parts.append('<button id=\\\"themeToggle\\\" aria-label=\\\"Toggle theme\\\">🌗</button>')\\nhtml_parts.append('</div>')\\nhtml_parts.append('</header>')\\nhtml_parts.append('<main id=\\\"results\\\">')\\nhtml_parts.append('<div id=\\\"cards\\\" class=\\\"grid\\\" aria-live=\\\"polite\\\"></div>')\\nhtml_parts.append('<div id=\\\"empty\\\" class=\\\"empty\\\" style=\\\"display:none\\\">No releases match your query.</div>')\\nhtml_parts.append('</main>')\\n# embed data\\nhtml_parts.append('<script id=\\\"data\\\" type=\\\"application/json\\\">')\\nhtml_parts.append(j)\\nhtml_parts.append('</script>')\\n# JS: render, search, filter, theme\\nhtml_parts.append('<script> (function(){const dataEl=document.getElementById(\\\"data\\\");let releases=[];try{releases=JSON.parse(dataEl.textContent)}catch(e){releases=[]}\\nconst cards=document.getElementById('\\\"cards\\\"');const empty=document.getElementById('\\\"empty\\\"');const q=document.getElementById('\\\"search\\\"');const filters=document.querySelectorAll('[data-filter]');const themeToggle=document.getElementById('\\\"themeToggle\\\"');\\nfunction esc(s){return String(s||'')} \\nfunction renderList(list){cards.innerHTML=''; if(!list.length){empty.style.display='block'; return} empty.style.display='none'; for(const r of list){const d=document.createElement('div');d.className='card'; const h=document.createElement('h3'); const a=document.createElement('a'); a.textContent=r.name||'(no title)'; a.href = r.url||'https://github.com/github/app/releases'; a.target='_blank'; a.rel='noopener noreferrer'; a.className='link'; h.appendChild(a); if(r.prerelease){const b=document.createElement('span');b.textContent='PRE'; b.className='badge'; h.appendChild(b)} d.appendChild(h); const p=document.createElement('p'); p.textContent = r.highlight || ''; p.style.margin='0'; p.style.fontSize='13px'; p.style.color=''; d.appendChild(p); const meta=document.createElement('div'); meta.className='meta'; meta.textContent = r.date || ''; meta.style.fontSize='12px'; meta.style.marginTop='8px'; d.appendChild(meta); cards.appendChild(d)} }\\nfunction applyFilter(){const term=q.value.trim().toLowerCase(); const active=document.querySelector('[data-filter][aria-pressed=\\\"true\\\"]').getAttribute('data-filter'); let list=releases.slice(); if(active==='prerelease') list=list.filter(x=>x.prerelease); else if(active==='stable') list=list.filter(x=>!x.prerelease); if(term){list=list.filter(x=>((x.name||'')+ ' ' + (x.highlight||'')).toLowerCase().includes(term))} renderList(list)}\\nfilters.forEach(btn=>btn.addEventListener('click',e=>{filters.forEach(b=>b.setAttribute('aria-pressed','false')); e.currentTarget.setAttribute('aria-pressed','true'); applyFilter()}))\\nq.addEventListener('input',applyFilter);\\nthemeToggle.addEventListener('click',()=>{const el=document.body; const cur=el.getAttribute('data-theme')||'light'; el.setAttribute('data-theme', cur==='light'?'dark':'light')})\\nreleases = releases = (releases = JSON.parse(dataEl.textContent||'[]'));\\napplyFilter(); })();</script>')\\n\\nhtml_parts.append('</div></body></html>')\\nfull='\\\\n'.join(html_parts)\\n# write to out\\noutp=Path('\\\"'+OUT_TMP+'\\\"')\\noutp.parent.mkdir(parents=True, exist_ok=True)\\noutp.write_text(full, encoding='utf-8')\\nprint('WROTE', outp)\\nPY\\n\\n# run generator\\npython3 \\\"$PY\\\"\\n\\n# compare with existing\\nif [ -f \\\"$DEST\\\" ]; then\\n  if cmp -s \\\"$OUT_TMP\\\" \\\"$DEST\\\"; then\\n    # identical\\n    echo '{\\\"message\\\":\\\"No changes: generated file is identical to existing docs/copilot-app-releases.html\\\"}' | safeoutputs noop .\\n    echo \\\"NOOP_SENT\\\"\\n    exit 0\\n  fi\\nfi\\n# different or dest missing -> create branch, commit, create PR\\nTS=$(date -